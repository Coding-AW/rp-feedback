# Store text with Linux line endings in the repository; Windows checkouts get
# Windows endings in the working folder.
* text=auto

# Files that run on the board: always Linux endings.
*.py    text eol=lf
*.sh    text eol=lf

# Vivado sources are text.
*.tcl   text
*.xdc   text
*.v     text
*.sv    text
*.vh    text

# Notebooks are kept free of outputs so their diffs stay readable. To clear one:
#     jupyter nbconvert --clear-output --inplace notebooks/<name>.ipynb
*.ipynb text

# Binary: never diff or merge as text.
*.bit   binary
*.bin   binary
*.png   binary
*.pdf   binary
*.zip   binary
*.dcp   binary
