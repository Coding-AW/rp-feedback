# Generated for a build: the pinned upstream checkout (.cache/upstream), the Vivado
# project and its runs. All of it is rebuilt from fpga/ and fpga/upstream.lock.
.cache/
.Xil/
**/.Xil/
*.jou
*.log
*.str

# Bitstreams are build output; the one qualified bitstream is kept on purpose.
*.bit
*.bin
*.bif
!bitstream/red_pitaya_top.bit

# Python, Jupyter and editor scratch
__pycache__/
*.pyc
.ipynb_checkpoints/
pytest-cache-files-*/
.vscode/
.idea/
*~
*.swp

# Never commit credentials
*.pem
*.key
id_rsa*
id_ed25519*
