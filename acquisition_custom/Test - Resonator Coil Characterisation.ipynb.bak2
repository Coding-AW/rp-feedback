    "\n",
    "# =============================================================================\n",
    "#  STEP 9c - WRITE THE RESULTS, AND LEAVE THE HARDWARE SAFE\n",
    "# =============================================================================\n",
    "results = {\n",
    "    'source_note': SOURCE_NOTE,\n",
    "    'measured_utc': time.strftime('%Y-%m-%dT%H:%M:%S', time.gmtime()),\n",
    "    'build_id': '0x%08X' % acq.build_id(),\n",
    "    'coil': {\n",
    "        'f0_hz': float(F0),\n",
    "        'linewidth_hz': float(LW),\n",
    "        'q_swept': float(Q_SWEEP),\n",
    "        'q_phase': (float(_qp) if _qp else None),\n",
    "        'q_ringdown': (float(_qr) if _qr else None),\n",
    "        'tau_s': float(Q_SWEEP / (np.pi * F0)),\n",
    "        'loop_delay_s': (float(globals()['TAU_LOOP'])\n",
    "                         if globals().get('TAU_LOOP') else None),\n",
    "    },\n",
    "    'coupling': {\n",
    "        'c_couple_f': C_COUPLE,\n",
    "        'c_stray_est_f': C_STRAY_EST,\n",
    "        'predicted_divider': float(C_COUPLE / (C_COUPLE + C_STRAY_EST)),\n",
    "        'xc_ohm_at_f0': float(1.0 / (2 * np.pi * F0 * C_COUPLE)),\n",
    "    },\n",
    "    'drive': {\n",
    "        'frac': DRIVE_FRAC,\n",
    "        'linear': bool(globals().get('LINEAR_OK', False)),\n",
    "    },\n",
    "    'receiver': {\n",
    "        'dec_log2': int(DEC_USE),\n",
    "        'output_rate_hz': float(FS_CLK / (1 << DEC_USE)),\n",
    "        'clean_halfwidth_hz': float(0.10 * FS_CLK / (1 << DEC_USE)),\n",
    "        'n_avg': N_AVG,\n",
    "    },\n",
    "    'stability': {\n",
    "        'drift_hz_per_min': float(_g('DRIFT_HZ_PER_MIN', float('nan'))),\n",
    "        'scatter_hz': float(_g('SCATTER_HZ', float('nan'))),\n",
    "    },\n",
    "    'feedback': {\n",
    "        'phi_narrow_deg': float(_g('PHI_NARROW', float('nan'))),\n",
    "        'phi_shift_deg': float(_g('PHI_SHIFT', float('nan'))),\n",
    "        'k_per_gain': float(_g('k_slope', float('nan'))),\n",
    "        'onset_gain_extrapolated': float(_g('A_ONSET', float('nan'))),\n",
    "        'note': ('phase axis is loop-dependent: cables, coil and any amplifier '\n",
    "                 'shift it. Only phases RELATIVE to phi_narrow are portable.'),\n",
    "    },\n",
    "    'selftest': {\n",
    "        'before_ok': bool(st1_before['ok']),\n",
    "        'after_ok': bool(st1_after['ok']),\n",
    "        'q_error_before_frac': float(st1_before['err_q_frac']),\n",
    "        'q_error_after_frac': float(st1_after['err_q_frac']),\n",
    "    },\n",
    "}\n",
    "\n",
    "with open(RESULTS_JSON, 'w') as fh:\n",
    "    json.dump(results, fh, indent=2, sort_keys=True)\n",
    "print('results written to %s' % os.path.abspath(RESULTS_JSON))\n",
    "\n",
    "# --- leave everything in the state it was found in ---------------------------\n",
    "gen.off()\n",
    "ps.off()\n",
    "emu.disable()\n",
    "acq.stop()\n",
    "print('')\n",
    "print('generator off, feedback off, emulator disabled, acquisition stopped.')\n",
    "print('The board is back to its power-on behaviour.')"
   ]
