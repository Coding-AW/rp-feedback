    "\n",
    "# =============================================================================\n",
    "#  SIGNAL GENERATOR  -  base 0x40200000, stock Red Pitaya module\n",
    "# =============================================================================\n",
    "#  It replays a 16384-entry table at a programmable rate. Load one sine cycle\n",
    "#  once; the frequency is then a single register write. The read pointer carries\n",
    "#  16 fractional bits, so a full cycle spans 16384 x 2**16 = 2**30 pointer units:\n",
    "#\n",
    "#      f = step x 125e6 / 2**30          (about 0.116 Hz per step)\n",
    "#\n",
    "#  At 40 MHz the pointer advances roughly 5200 table entries per clock, so the\n",
    "#  table is read very sparsely - that is fine and is exactly what producing a\n",
    "#  40 MHz sine from a 125 MHz converter means.\n",
    "#\n",
    "#  Register recipe: 0x04 amplitude (0x2000 = x1.0), 0x08 table size, 0x0C start\n",
    "#  offset, 0x10 step, table at 0x10000. Control 0x00: bit 6 resets the pointer,\n",
    "#  0x11 = free-run with wraparound, 0xC0 = held in reset with the output at zero.\n",
    "# =============================================================================\n",
    "class Generator(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40200000, span=0x20000)\n",
    "        self._step = None\n",
    "\n",
    "    def load_sine(self):\n",
    "        \"\"\"Write one cycle of a sine into the table. Takes a second or two:\n",
    "        16384 single-word writes, and single-word is not negotiable here.\"\"\"\n",
    "        for i in range(16384):\n",
    "            v = int(round(8191.0 * np.sin(2.0 * np.pi * i / 16384.0)))\n",
    "            self.w(0x10000 + 4 * i, v & 0x3FFF)\n",
    "        self.w(0x08, (16384 << 16) - 1)     # table size, fixed point, inclusive\n",
    "        self.w(0x0C, 0)                     # start replaying from entry 0\n",
    "\n",
    "    def freq_word(self, f):\n",
    "        \"\"\"Nearest 30-bit frequency word to f hertz.\"\"\"\n",
    "        return int(round(f / FS_CLK * (1 << 30)))\n",
    "\n",
    "    def set_word(self, step):\n",
    "        \"\"\"Set frequency by raw word; return the frequency actually produced.\"\"\"\n",
    "        self._step = int(step)\n",
    "        self.w(0x10, self._step)\n",
    "        return self._step * FS_CLK / float(1 << 30)\n",
    "\n",
    "    def freq(self, f):\n",
    "        \"\"\"Set frequency in hertz; return the frequency actually produced.\"\"\"\n",
    "        return self.set_word(self.freq_word(f))\n",
    "\n",
    "    def lo_word(self):\n",
    "        \"\"\"The 32-bit local-oscillator word that lands this signal EXACTLY at\n",
    "        0 Hz. The generator counts in units of 2**-30 of the clock and the local\n",
    "        oscillator in units of 2**-32, so the conversion is a factor of four and\n",
    "        carries no rounding error at all.\"\"\"\n",
    "        return 4 * self._step\n",
    "\n",
    "    def amp(self, frac):\n",
    "        \"\"\"Output amplitude as a fraction of full scale. CLAMPED, deliberately.\n",
    "\n",
    "        The register is Q1.13 with 0x2000 = x1.0, and it happily accepts up to\n",
    "        0x3FFF = x1.9999. The write below is masked with & 0x3FFF, so before this\n",
    "        guard existed the mask turned mistakes into silent, WRONG drive levels:\n",
    "\n",
    "            frac = -0.5  ->  0x3000  ->  x1.5   (a sign slip drives 50% HARDER)\n",
    "            frac =  2.0  ->  0x0000  ->  x0.0   (silence, and no complaint)\n",
    "            frac =  1.5  ->  0x3000  ->  x1.5   (clipped square wave, not a sine)\n",
    "\n",
    "        Every one of those is silent on the bench. Anything outside\n",
    "        [0, DRIVE_MAX] is now refused instead, so the only way to drive the coil\n",
    "        harder is to raise DRIVE_MAX in the configuration cell on purpose.\"\"\"\n",
    "        frac = float(frac)\n",
    "        if not np.isfinite(frac):\n",
    "            raise ValueError('drive amplitude is not a finite number: %r' % frac)\n",
    "        if frac < 0.0:\n",
    "            raise ValueError(\n",
    "                'negative drive amplitude (%.4f). A sign has no meaning here, and '\n",
    "                'the register would silently wrap it to x%.4f.'\n",
    "                % (frac, (int(round(frac * 8192)) & 0x3FFF) / 8192.0))\n",
    "        if frac > DRIVE_MAX:\n",
    "            raise ValueError(\n",
    "                'drive %.4f exceeds DRIVE_MAX = %.4f. Nothing in this notebook '\n",
    "                'may drive harder than the ceiling; raise it in the configuration '\n",
    "                'cell if that is really what you want.' % (frac, DRIVE_MAX))\n",
    "        self.w(0x04, int(round(frac * 8192)) & 0x3FFF)\n",
    "\n",
    "    def run(self):\n",
    "        self.w(0x00, 0x40)      # reset the read pointer\n",
    "        self.w(0x00, 0x11)      # free-run, wrap at the end of the table\n",
    "\n",
    "    def off(self):\n",
    "        self.amp(0.0)\n",
    "        self.w(0x00, 0xC0)      # held in reset, output forced to zero\n",
    "\n",
    "\n",
    "gen = Generator()\n",
    "gen.off()\n",
    "gen.load_sine()\n",
    "print('generator ready, table loaded, output off')"
   ]
  },
