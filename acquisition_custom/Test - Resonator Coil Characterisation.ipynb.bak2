    "\n",
    "# =============================================================================\n",
    "#  STEP 5b - RING-DOWN, in the time domain\n",
    "# =============================================================================\n",
    "def moving_rms(x, w):\n",
    "    \"\"\"Root-mean-square over a sliding window - the envelope, however the scope\n",
    "    happens to be treating the carrier.\"\"\"\n",
    "    w = max(2, int(w))\n",
    "    c = np.cumsum(np.concatenate([[0.0], x.astype(float) ** 2]))\n",
    "    return np.sqrt((c[w:] - c[:-w]) / w)\n",
    "\n",
    "\n",
    "def ringdown(dec):\n",
    "    \"\"\"Drive, cut the drive, capture, and fit the decay. Returns a dict.\n",
    "\n",
    "    The scope is armed and software-triggered FIRST, and the drive killed\n",
    "    immediately afterwards, so the switch-off lands somewhere inside the record.\n",
    "    Where exactly is unpredictable - Python is not a real-time system - so the\n",
    "    edge is located from the data.\"\"\"\n",
    "    gen.freq(F0)\n",
    "    gen.amp(DRIVE_FRAC)\n",
    "    gen.run()\n",
    "    time.sleep(0.05)\n",
    "\n",
    "    # Full drive, exactly on resonance, held for the length of a capture. This\n",
    "    # is the hardest the coil is driven anywhere in the notebook, and unlike a\n",
    "    # sweep there is no per-point guard once the capture is armed - so check the\n",
    "    # level here, before arming, and refuse rather than proceed.\n",
    "    lvl = sc.peak_frac(1024)\n",
    "    if lvl > FB_LEVEL_GUARD:\n",
    "        gen.off()\n",
    "        raise RuntimeError('input at %.3f of full scale on resonance, above the '\n",
    "                           '%.2f guard - lower DRIVE_FRAC before the ring-down'\n",
    "                           % (lvl, FB_LEVEL_GUARD))\n",
    "\n",
    "    sc.w(0x14, dec)\n",
    "    sc.w(0x10, SC_NMAX - 1)\n",
    "    sc.w(0x00, 2)          # reset\n",
    "    sc.w(0x00, 1)          # arm\n",
    "    sc.w(0x04, 1)          # trigger now\n",
    "    gen.amp(0.0)           # <- the switch-off: one register write\n",
    "\n",
    "    try:\n",
    "        t0 = time.time()\n",
    "        while sc.r(0x04) != 0:\n",
    "            if time.time() - t0 > 2.0:\n",
    "                break\n",
    "        time.sleep(0.005)\n",
    "        x = sc._buf(SC_BUF_A, SC_NMAX)\n",
    "    finally:\n",
    "        gen.off()\n",
    "\n",
    "    fs = FS_CLK / float(dec)\n",
    "    tau_expect = Q_SWEEP / (np.pi * F0)\n",
    "    w = max(4, int(round(0.25 * tau_expect * fs)))\n",
    "    env = moving_rms(x, w)\n",
    "    t = np.arange(len(env)) / fs\n",
    "\n",
    "    n = len(env)\n",
    "    high = float(np.median(env[:max(8, n // 20)]))\n",
    "    floor = float(np.median(env[-max(8, n // 20):]))\n",
    "    result = dict(dec=dec, fs=fs, t=t, env=env, high=high, floor=floor,\n",
    "                  contrast=high / max(floor, 1e-300), ok=False, why=None)\n",
    "\n",
    "    if result['contrast'] < 10.0:\n",
    "        result['why'] = ('only %.1fx between drive-on and drive-off - the '\n",
    "                         'envelope is not clear of the noise' % result['contrast'])\n",
    "        return result\n",
    "\n",
    "    below = np.where(env < 0.6 * high)[0]\n",
    "    if len(below) == 0:\n",
    "        result['why'] = 'no switch-off edge inside the record - use a larger decimation'\n",
    "        return result\n",
    "    k0 = int(below[0])\n",
    "\n",
    "    stop = np.where(env[k0:] < max(3.0 * floor, 0.05 * high))[0]\n",
    "    k1 = k0 + int(stop[0]) if len(stop) else len(env)\n",
    "    if k1 - k0 < 4:\n",
    "        result['why'] = 'fewer than 4 usable points in the decay - use a smaller decimation'\n",
    "        return result\n",
    "\n",
    "    seg_t = t[k0:k1]\n",
    "    seg_e = env[k0:k1]\n",
    "    slope, _ = np.polyfit(seg_t, np.log(np.maximum(seg_e - floor, 1e-12)), 1)\n",
    "    if slope >= 0:\n",
    "        result['why'] = 'the envelope did not decay - is the drive really being cut?'\n",
    "        return result\n",
    "\n",
    "    tau = -1.0 / slope\n",
    "    result.update(ok=True, k0=k0, k1=k1, tau=tau,\n",
    "                  pts_per_tau=tau * fs, Q=np.pi * F0 * tau)\n",
    "    if result['pts_per_tau'] < RING_MIN_PTS:\n",
    "        result['ok'] = False\n",
    "        result['why'] = ('only %.1f points per time constant (need %d) - use a '\n",
    "                         'smaller decimation' % (result['pts_per_tau'], RING_MIN_PTS))\n",
    "    return result\n",
    "\n",
    "\n",
    "RING = None\n",
    "for _dec in RING_DECS:\n",
    "    _r = ringdown(_dec)\n",
    "    print('5b  decimation %-5d record %.2f ms, %.0f ns/sample, contrast %.0fx : %s'\n",
    "          % (_dec, len(_r['env']) / _r['fs'] * 1e3, 1e9 / _r['fs'],\n",
    "             _r['contrast'], 'usable' if _r['ok'] else _r['why']))\n",
    "    if _r['ok']:\n",
    "        RING = _r\n",
    "        break\n",
    "\n",
    "print('')\n",
    "if RING is None:\n",
    "    Q_RING = None\n",
    "    print('5b: no usable ring-down. This is a limitation of switching the drive')\n",
    "    print('    from software, not evidence against the coil. Step 5a still stands')\n",
    "    print('    as an independent check; note the gap and move on.')\n",
    "else:\n",
    "    Q_RING = RING['Q']\n",
    "    print('5b  decay time constant : %.3f us (%.1f points across it)'\n",
    "          % (RING['tau'] * 1e6, RING['pts_per_tau']))\n",
    "    print('    Q from the ring-down: %.1f' % Q_RING)\n",
    "    print('    Q from the sweep    : %.1f' % Q_SWEEP)\n",
    "    print('    disagreement        : %+.1f%%' % (100 * (Q_RING / Q_SWEEP - 1.0)))\n",
    "    if abs(Q_RING / Q_SWEEP - 1.0) > 0.15:\n",
    "        print('    WARNING: more than 15%% apart. Two independent methods')\n",
    "        print('    disagreeing is the signal this whole step exists to raise.')\n",
    "        print('    Suspect, in order: a sloping baseline under the swept fit, a')\n",
    "        print('    stray tone inside the receiver window, compression at this')\n",
    "        print('    drive level (Step 6 tests that directly).')\n",
    "    else:\n",
    "        print('    the two methods agree - the quality factor is real')\n",
    "\n",
    "if RING is not None:\n",
    "    fig, ax = plt.subplots(figsize=(7.5, 3.2))\n",
    "    ax.semilogy(RING['t'] * 1e6, np.maximum(RING['env'], 1e-3), '-', lw=1.0)\n",
    "    ax.axvline(RING['t'][RING['k0']] * 1e6, ls='--', lw=1.0, color='C3',\n",
    "               label='drive cut')\n",
    "    _tt = RING['t'][RING['k0']:RING['k1']]\n",
    "    ax.semilogy(_tt * 1e6,\n",
    "                RING['floor'] + (RING['env'][RING['k0']] - RING['floor'])\n",
    "                * np.exp(-(_tt - _tt[0]) / RING['tau']),\n",
    "                '-', lw=1.6, color='C1', label='exponential fit')\n",
    "    ax.set_xlim(max(0, RING['t'][RING['k0']] * 1e6 - 5 * RING['tau'] * 1e6),\n",
    "                RING['t'][RING['k0']] * 1e6 + 12 * RING['tau'] * 1e6)\n",
    "    ax.set_xlabel('time / us')\n",
    "    ax.set_ylabel('envelope (counts, log scale)')\n",
    "    ax.set_title('Step 5b - ring-down, tau = %.2f us, Q = %.1f'\n",
    "                 % (RING['tau'] * 1e6, Q_RING))\n",
    "    ax.legend(fontsize=8)\n",
    "    ax.grid(color='0.85', lw=0.6, which='both'); ax.set_axisbelow(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "\n",
    "---\n",
    "# Step 6 — Is the measurement linear?\n",
    "\n",
    "The definitive test for \"am I loading the coil?\" is to weaken the coupling and see whether the\n",
    "quality factor stops changing. With the capacitors soldered on, that test is not available —\n",
    "so this is the one that is.\n",
    "\n",
    "Drive at three levels, each 6 dB apart, and fit each. A **linear** system returns the same\n",
    "centre and the same width at all three; only the height changes. If either moves with drive\n",
    "level, something is compressing — the input stage, the coil itself, or an amplifier if one is\n",
    "fitted — and every number in this notebook taken at the higher level is suspect.\n",
    "\n",
    "This is also the cheapest way to discover you have been running with `DRIVE_FRAC` too high."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  STEP 6 - LINEARITY\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 6 - linearity against drive level')\n",
    "print('=' * 68)\n",
    "\n",
    "acq.start(DEC_USE)\n",
    "grid6 = F0 + np.linspace(-2.5, 2.5, 41) * LW\n",
    "\n",
    "lin_rows = []\n",
    "for frac in DRIVE_FRACS_LIN:\n",
    "    f6, z6 = sweep(grid6, drive_frac=frac, navg=N_AVG, level_guard=0.95)\n",
    "    gen.amp(0.0)\n",
    "    fit6 = fit_lorentzian(f6, np.abs(z6) ** 2)\n",
    "    lin_rows.append((frac, fit6))\n",
    "    print('  drive %5.3f (%+5.1f dB) : f0 = %.6f MHz, lw = %.2f kHz, '\n",
    "          'Q = %6.1f, peak = %.3e'\n",
    "          % (frac, 20 * np.log10(frac / DRIVE_FRACS_LIN[0]),\n",
    "             fit6['f0'] / 1e6, fit6['lw'] / 1e3, fit6['Q'], fit6['peak']))\n",
    "\n",
    "_f0s = np.array([r[1]['f0'] for r in lin_rows])\n",
    "_qs = np.array([r[1]['Q'] for r in lin_rows])\n",
    "_pk = np.array([r[1]['peak'] for r in lin_rows])\n",
    "_fr = np.array([r[0] for r in lin_rows])\n",
    "\n",
    "# NOT d_f0: Step 7 uses that name for its array of fitted centres.\n",
    "d_f0_spread = (_f0s.max() - _f0s.min()) / LW\n",
    "d_q = (_qs.max() - _qs.min()) / _qs.mean()\n",
    "# a linear system's peak power scales as the square of the drive\n",
    "scale_err = _pk / (_pk[0] * (_fr / _fr[0]) ** 2) - 1.0\n",
    "\n",
    "print('')\n",
    "print('  centre spread across the ladder : %.3f linewidths' % d_f0_spread)\n",
    "print('  Q spread across the ladder      : %.1f%%' % (100 * d_q))\n",
    "print('  peak power vs drive-squared     : %s'\n",
    "      % ', '.join('%+.1f%%' % (100 * e) for e in scale_err))\n",
    "print('-' * 68)\n",
    "LINEAR_OK = (d_f0_spread < 0.10) and (d_q < 0.05) and (np.max(np.abs(scale_err)) < 0.15)\n",
    "if LINEAR_OK:\n",
    "    print('PASS - centre, width and scaling are all drive-independent')\n",
    "else:\n",
    "    print('CHECK - something moves with drive level. Lower DRIVE_FRAC until it')\n",
    "    print('        stops, and repeat Steps 3 and 5 at the lower level.')"
   ]
  },
