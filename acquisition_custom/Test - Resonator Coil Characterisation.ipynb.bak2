    "\n",
    "# =============================================================================\n",
    "#  STEP 2b - BAND SURVEY, generator off\n",
    "# =============================================================================\n",
    "#  Step the receiver across the search band and record the power in each\n",
    "#  window. The step is a fraction of the clean window width so nothing can hide\n",
    "#  in a gap between windows - the same discipline the adaptive sweep uses.\n",
    "# =============================================================================\n",
    "acq.start(DEC_SEARCH)\n",
    "f_out_s = acq.f_out()\n",
    "step_s = 0.15 * f_out_s                       # windows overlap generously\n",
    "survey_f = np.arange(SEARCH_LO, SEARCH_HI + step_s, step_s)\n",
    "\n",
    "gen.off()\n",
    "survey_p = np.zeros(len(survey_f))\n",
    "t0 = time.time()\n",
    "for k, f in enumerate(survey_f):\n",
    "    z = capture(int(round(f / FS_CLK * (1 << 32))), DEC_SEARCH, 1024, settle=0.004)\n",
    "    survey_p[k] = float(np.mean(np.abs(z) ** 2))\n",
    "print('surveyed %d windows across %.1f - %.1f MHz in %.0f s'\n",
    "      % (len(survey_f), SEARCH_LO / 1e6, SEARCH_HI / 1e6, time.time() - t0))\n",
    "\n",
    "# --- report the strongest features, as decibels above the median window ------\n",
    "med = float(np.median(survey_p))\n",
    "excess_db = 10.0 * np.log10(np.maximum(survey_p, 1e-300) / max(med, 1e-300))\n",
    "order = np.argsort(excess_db)[::-1]\n",
    "\n",
    "print('')\n",
    "print('median window power      : %.3e  (this is the noise floor)' % med)\n",
    "print('strongest windows (dB above the median):')\n",
    "print('    frequency / MHz    excess / dB')\n",
    "shown = 0\n",
    "for idx in order:\n",
    "    if excess_db[idx] < 6.0 or shown >= 10:\n",
    "        break\n",
    "    print('    %14.4f     %+8.1f' % (survey_f[idx] / 1e6, excess_db[idx]))\n",
    "    shown += 1\n",
    "if shown == 0:\n",
    "    print('    (nothing more than 6 dB above the median - a clean band)')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9.0, 3.2))\n",
    "ax.plot(survey_f / 1e6, excess_db, '-', lw=1.0)\n",
    "ax.axhline(6.0, ls='--', lw=0.9, color='0.5', label='6 dB reporting threshold')\n",
    "ax.set_xlabel('receiver centre / MHz')\n",
    "ax.set_ylabel('dB above median')\n",
    "ax.set_title('Step 2 - band survey, generator off   [%s]' % SOURCE_NOTE)\n",
    "ax.legend(fontsize=8)\n",
    "ax.grid(color='0.85', lw=0.6)\n",
    "ax.set_axisbelow(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('')\n",
    "print('KEEP THIS PLOT. With the input terminated it is the board\\'s own spectrum;')\n",
    "print('with the coil attached, anything NEW is the coil or the room.')"
   ]
