   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  MEMORY CAPTURE\n",
    "# =============================================================================\n",
    "def _be32(b, i=0):\n",
    "    return struct.unpack('>I', b[i * 4:i * 4 + 4])[0]\n",
    "\n",
    "\n",
    "def _dt_read(path):\n",
    "    for root in ('/sys/firmware/devicetree/base', '/proc/device-tree'):\n",
    "        try:\n",
    "            with open(os.path.join(root, path), 'rb') as fh:\n",
    "                return fh.read()\n",
    "        except (IOError, OSError):\n",
    "            pass\n",
    "    return None\n",
    "\n",
    "\n",
    "_blob = _dt_read('memory/reg') or _dt_read('memory@0/reg')\n",
    "assert _blob and len(_blob) >= 8, 'cannot read the device tree memory node'\n",
    "_declared_end = _be32(_blob, 0) + _be32(_blob, 1)\n",
    "assert _declared_end < 512 * 1024 ** 2, \\\n",
    "    'no memory above the declared end - see Test Stage 6 Step 1'\n",
    "\n",
    "MEM_START = (_declared_end + 0xFFF) & ~0xFFF\n",
    "MEM_SIZE = 0x00800000                        # 8 MB is far more than needed\n",
    "MEM_STOP = MEM_START + (MEM_SIZE & ~7) - 8   # LAST address, INCLUSIVE\n",
    "POISON = 0xDEADBEEF\n",
    "\n",
    "print('capture region 0x%08X .. 0x%08X inclusive (%d MB)'\n",
    "      % (MEM_START, MEM_STOP + 7, MEM_SIZE // (1024 * 1024)))\n",
    "\n",
    "\n",
    "def _poison(nbytes):\n",
    "    fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)\n",
    "    mm = mmap.mmap(fd, ((nbytes + 4095) // 4096) * 4096, offset=MEM_START)\n",
    "    try:\n",
    "        mm[0:nbytes] = np.full(nbytes // 4, POISON, dtype='<u4').tobytes()\n",
    "    finally:\n",
    "        mm.close()\n",
    "        os.close(fd)\n",
    "\n",
    "\n",
    "def _read_region(nbytes):\n",
    "    \"\"\"Bulk read of DDR. try/finally because everything here can raise, and a\n",
    "    leaked mapping inside a scan loop surfaces much later as an unrelated-\n",
    "    looking out-of-memory error.\"\"\"\n",
    "    fd = mm = None\n",
    "    try:\n",
    "        fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)\n",
    "        mm = mmap.mmap(fd, ((nbytes + 8191) // 4096) * 4096, offset=MEM_START)\n",
    "        return mm[0:nbytes]\n",
    "    finally:\n",
    "        if mm is not None:\n",
    "            mm.close()\n",
    "        if fd is not None:\n",
    "            os.close(fd)\n",
    "\n",
    "\n",
    "def capture(lo_word, dec_log2, n_samples, settle=None):\n",
    "    \"\"\"Record n_samples of the complex stream. Returns a complex numpy array.\n",
    "\n",
    "    lo_word is the RAW 32-bit local-oscillator word, so a caller that wants an\n",
    "    exact zero-frequency landing can pass gen.lo_word() and get it. Raises on\n",
    "    any transport fault rather than returning plausible garbage.\"\"\"\n",
    "    settle = SETTLE if settle is None else settle\n",
    "    if n_samples * 8 > (MEM_STOP + 8 - MEM_START):\n",
    "        raise ValueError('record of %d samples exceeds the capture region' % n_samples)\n",
    "\n",
    "    _poison(n_samples * 8)\n",
    "\n",
    "    acq.w(0x00, 0)                       # disable while settings change\n",
    "    acq.w(0x08, dec_log2)\n",
    "    acq.w(0x0C, 0)\n",
    "    acq.dec = dec_log2\n",
    "    acq.tune_word(lo_word)\n",
    "    acq.w(0x28, MEM_START)\n",
    "    acq.w(0x2C, MEM_STOP)\n",
    "\n",
    "    lo_rb, hi_rb = acq.r(0x28), acq.r(0x2C)\n",
    "    if lo_rb != MEM_START or hi_rb != MEM_STOP:\n",
    "        acq.w(0x00, 0)\n",
    "        raise RuntimeError(\n",
    "            'capture bounds did not take: wrote 0x%08X..0x%08X, read back '\n",
    "            '0x%08X..0x%08X. Refusing to arm an unbounded memory writer.'\n",
    "            % (MEM_START, MEM_STOP, lo_rb, hi_rb))\n",
    "\n",
    "    acq.w(0x00, 1 | 2)                   # run at the new tuning...\n",
    "    acq.w(0x00, 1)\n",
    "    time.sleep(settle)                   # ...let the pipeline flush...\n",
    "    acq.w(0x00, 1 | 16 | 128)            # ...then arm with a fresh writer\n",
    "    acq.w(0x00, 1 | 16)\n",
    "\n",
    "    t_record = n_samples * (1 << dec_log2) / FS_CLK\n",
    "    deadline = time.time() + t_record + 0.5\n",
    "    while int(acq.r(0x34)) < n_samples and time.time() < deadline:\n",
    "        time.sleep(0.001)\n",
    "    acq.w(0x00, 1)                       # disarm\n",
    "    time.sleep(0.002)                    # let the last burst land\n",
    "\n",
    "    st2 = acq.r(0x38)\n",
    "    if st2 & 8:\n",
    "        raise RuntimeError('memory refused writes - run check_system.py')\n",
    "    got = min(int(acq.r(0x34)), n_samples)\n",
    "    if got < n_samples:\n",
    "        raise RuntimeError('short record: asked %d, got %d' % (n_samples, got))\n",
    "\n",
    "    buf = _read_region(got * 8)\n",
    "    u32 = np.frombuffer(buf, dtype='<u4')\n",
    "    limit = max(8, 0.001 * u32.size)\n",
    "    if int(np.count_nonzero(u32 == POISON)) > limit:\n",
    "        # A word still inside the writer's burst buffer is not a lost word. If\n",
    "        # it is genuinely lost it will still be poison in 20 ms.\n",
    "        time.sleep(0.02)\n",
    "        u32 = np.frombuffer(_read_region(got * 8), dtype='<u4')\n",
    "        if int(np.count_nonzero(u32 == POISON)) > limit:\n",
    "            raise RuntimeError('unwritten words in the record - transport fault')\n",
    "\n",
    "    iq = u32.astype(np.int64)\n",
    "    i = np.where(iq[0::2] & 0x80000000, iq[0::2] - (1 << 32), iq[0::2])\n",
    "    q = np.where(iq[1::2] & 0x80000000, iq[1::2] - (1 << 32), iq[1::2])\n",
    "    return i.astype(float) + 1j * q.astype(float)"
   ]
  },
