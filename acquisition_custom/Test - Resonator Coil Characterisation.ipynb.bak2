    "\n",
    "# =============================================================================\n",
    "#  DIGITAL RESONATOR (THE EMULATOR)  -  base 0x40400000\n",
    "# =============================================================================\n",
    "#  Used in ONE place in this notebook: Step 1, to prove the instrument still\n",
    "#  returns an answer it was given, before and after the real measurements.\n",
    "#\n",
    "#  It is a register bit, not a cable. Enabled, it REPLACES the digitised input,\n",
    "#  so the coil can stay connected and simply be ignored. That means the\n",
    "#  known-answer check is available at any moment, including in the middle of a\n",
    "#  bench session - which is the single most useful safety net available here.\n",
    "#\n",
    "#  Coefficients: c = r cos(w0) x 2**17, s = r sin(w0) x 2**17, with\n",
    "#  w0 = 2 pi f0 / 125e6 and r = 1 - pi (f0/125e6) / Q. Rounding those to 18-bit\n",
    "#  integers moves the pole slightly, so the QUANTISED values - recovered below\n",
    "#  as f0_q and q_q - are the real known answer, not the numbers asked for.\n",
    "# =============================================================================\n",
    "class Emulator(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40400000)\n",
    "        self.f0_q = None\n",
    "        self.q_q = None\n",
    "\n",
    "    def config(self, f0, Q, delay=15, oshift=7):\n",
    "        w0 = 2.0 * np.pi * f0 / FS_CLK\n",
    "        r = 1.0 - np.pi * (f0 / FS_CLK) / Q\n",
    "        ci = int(round(r * np.cos(w0) * 131072))\n",
    "        cs = int(round(r * np.sin(w0) * 131072))\n",
    "        self.w(0x04, ci & 0x3FFFF)\n",
    "        self.w(0x08, cs & 0x3FFFF)\n",
    "        self.w(0x0C, delay)      # 15 clocks = the board's real 119.87 ns loop\n",
    "        self.w(0x10, oshift)\n",
    "        rq = np.hypot(ci, cs) / 131072.0\n",
    "        self.f0_q = np.arctan2(cs, ci) / (2.0 * np.pi) * FS_CLK\n",
    "        self.q_q = np.pi * (self.f0_q / FS_CLK) / (1.0 - rq)\n",
    "        return self.f0_q, self.q_q\n",
    "\n",
    "    def enable(self):\n",
    "        self.w(0x00, 1)\n",
    "\n",
    "    def disable(self):\n",
    "        self.w(0x00, 0)\n",
    "\n",
    "    def clear(self):\n",
    "        self.w(0x00, 3)          # zero the state and the sticky clip flag\n",
    "\n",
    "    def enabled(self):\n",
    "        return bool(self.r(0x00) & 1)\n",
    "\n",
    "    def clipped(self):\n",
    "        return bool(self.r(0x14) & 1)\n",
    "\n",
    "\n",
    "emu = Emulator()\n",
    "emu.disable()\n",
    "print('emulator mapped and DISABLED (the board is listening to its real input)')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  INTERNAL SCOPE  -  base 0x40100000\n",
    "# =============================================================================\n",
    "#  Captures 16384 samples of the RAW input at up to the full 125 MSa/s. Two jobs\n",
    "#  here, neither of which the acquisition chain can do:\n",
    "#\n",
    "#   * LEVEL CHECK. There is no input-overload detection anywhere in this design.\n",
    "#     The emulator has a sticky clip flag, but that is the emulator's, and it is\n",
    "#     gone the moment you measure a real coil. This is the only guard.\n",
    "#   * RING-DOWN. The decay lasts microseconds. At the decimations the\n",
    "#     acquisition chain uses, the whole event fits inside one output sample.\n",
    "#\n",
    "#  The equalisation filter this block once carried has been REMOVED from the\n",
    "#  design (1173 timing violations, and switched off anyway). Its coefficient\n",
    "#  registers still accept writes and do nothing. For these measurements that is\n",
    "#  an improvement: the scope is now a flat, unmodified path.\n",
    "#\n",
    "#  It sees the same signal the rest of the chain does - so with the emulator\n",
    "#  enabled it shows the emulator, not the input.\n",
    "# =============================================================================\n",
    "SC_BASE = 0x40100000\n",
    "SC_SPAN = 0x40000\n",
    "SC_BUF_A = 0x10000\n",
    "SC_BUF_B = 0x20000\n",
    "SC_NMAX = 1 << 14\n",
    "\n",
    "\n",
    "class Scope(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, SC_BASE, span=SC_SPAN)\n",
    "\n",
    "    def _buf(self, off, n):\n",
    "        \"\"\"Read n samples, one 32-bit word at a time (this is a register block,\n",
    "        not DDR). The buffer holds 14-bit two's-complement values.\"\"\"\n",
    "        ba = bytearray(4 * n)\n",
    "        m = self.m\n",
    "        for i in range(n):\n",
    "            o = off + 4 * i\n",
    "            ba[4 * i:4 * i + 4] = m[o:o + 4]\n",
    "        v = np.frombuffer(bytes(ba), dtype='<u4').astype(np.int64) & 0x3FFF\n",
    "        return np.where(v & 0x2000, v - 0x4000, v).astype(float)\n",
    "\n",
    "    def acquire(self, dec=1, n=SC_NMAX, chan='A'):\n",
    "        \"\"\"Capture and return (samples, sample_rate). dec = 1 is every sample.\"\"\"\n",
    "        self.w(0x14, dec)\n",
    "        self.w(0x10, n - 1)\n",
    "        self.w(0x00, 2)        # reset the capture engine\n",
    "        self.w(0x00, 1)        # arm\n",
    "        self.w(0x04, 1)        # trigger now, from software\n",
    "        t0 = time.time()\n",
    "        while self.r(0x04) != 0:\n",
    "            if time.time() - t0 > 1.0:\n",
    "                break\n",
    "        time.sleep(0.005)\n",
    "        off = SC_BUF_A if chan == 'A' else SC_BUF_B\n",
    "        return self._buf(off, n), FS_CLK / float(dec)\n",
    "\n",
    "    def peak_frac(self, n=4096):\n",
    "        \"\"\"Peak input level as a fraction of full scale. 1.0 means clipping.\"\"\"\n",
    "        x, _ = self.acquire(dec=1, n=n)\n",
    "        return float(np.max(np.abs(x))) / 8191.0\n",
    "\n",
    "\n",
    "sc = Scope()\n",
    "print('scope mapped, %d samples per capture' % SC_NMAX)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "#  ALL_OFF  -  the one call that makes the hardware harmless\n",
    "# =============================================================================\n",
    "#  Every step below that raises the drive does so inside a try/finally that ends\n",
    "#  here, so an exception, a failed fit or an interrupted cell cannot leave the\n",
    "#  coil being driven with the feedback loop closed. It is also registered to run\n",
    "#  when the kernel shuts down.\n",
    "#\n",
    "#  Safe to call at any time, including twice, including when nothing is running.\n",
    "#  If anything ever looks wrong on the bench, run all_off() in a fresh cell.\n",
    "# =============================================================================\n",
    "def all_off():\n",
    "    \"\"\"Silence the drive, open the feedback loop, disable the emulator.\"\"\"\n",
    "    for what, fn in (('generator', lambda: gen.off()),\n",
    "                     ('feedback', lambda: ps.off()),\n",
    "                     ('emulator', lambda: emu.disable())):\n",
    "        try:\n",
    "            fn()\n",
    "        except Exception as exc:\n",
    "            # One block failing to switch off must never stop the others being\n",
    "            # switched off - the generator is the one that matters.\n",
    "            print('all_off: could not switch off the %s (%s)' % (what, exc))\n",
    "\n",
    "\n",
    "import atexit\n",
    "atexit.register(all_off)\n",
    "all_off()\n",
    "print('all_off() defined and armed - drive, feedback and emulator are all off')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "\n",
    "---\n",
    "# Recording to memory\n",
    "\n",
    "The voltmeter cannot see a spectrum — it reports one number per tuning. Spectra need time\n",
    "records, and time records need memory. This is the Stage 6/7 transport, condensed, with every\n",
    "safeguard kept:\n",
    "\n",
    "- **The region comes from the device tree**, not from a constant. It must be memory Linux has\n",
    "  been told not to use.\n",
    "- **The bounds are read back before arming.** The writer is a direct-memory-access master: if\n",
    "  the stop bound did not take, it runs from the start address upward through whatever follows,\n",
    "  and what follows is the memory the operating system is using. That is not an exception with\n",
    "  a traceback — it is a dead board. Two register reads turn the worst failure mode here into\n",
    "  a sentence.\n",
    "- **The region is pre-filled with a poison value.** Anything still poisoned afterwards was\n",
    "  never written, so a short or torn record cannot masquerade as data.\n",
    "- **Settle first, record second.** Arming and then sleeping would let the opening milliseconds\n",
    "  of the record catch the filter pipeline still flushing the *previous* tuning. In a sweep\n",
    "  that poisons each point with its predecessor's power — most visibly the first point, which\n",
    "  sits at the end of the fit and has maximum leverage.\n",
    "- **Wait for the writer; do not guess.** The sample counter reports words handed *to* the\n",
    "  writer, not words landed in memory, so the poll is followed by a short grace period for the\n",
    "  last burst.\n",
    "\n",
    "Note the asymmetry with the register rule: DDR is read here in one bulk slice, which is fine\n",
    "and fast. It is only the *register* bus that must be touched one word at a time."
   ]
  },
