    "_model = FIT['peak'] / (1.0 + (2.0 * (_fine - F0) / LW) ** 2) + FIT['base']\n",
    "\n",
    "fig, (a1, a2) = plt.subplots(2, 1, figsize=(8.0, 5.6), sharex=False)\n",
