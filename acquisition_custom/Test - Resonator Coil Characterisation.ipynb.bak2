    "    ph1.plot(_df / 1e3, np.degrees(_model), '-', lw=1.4,\n",
    "            label='fit: lw = %.1f kHz, delay = %.0f ns'\n",
    "                  % (LW_PHASE / 1e3, TAU_LOOP * 1e9))\n",
    "    ph1.plot(_df / 1e3, np.degrees(-np.arctan(2.0 * _df / LW_PHASE)), '--', lw=1.0,\n",
    "            color='0.5', label='resonator alone (delay removed)')\n",
    "    ph1.set_ylabel('phase / degrees')\n",
    "    ph1.set_title('Step 5a - linewidth and transport delay, fitted together')\n",
    "    ph1.legend(fontsize=8)\n",
    "    ph1.grid(color='0.85', lw=0.6); ph1.set_axisbelow(True)\n",
    "\n",
    "    ph2.plot(_df / 1e3, np.degrees(_ph - _model), 'o-', ms=3, lw=0.8, color='C3')\n",
    "    ph2.axhline(0.0, ls=':', lw=1.0, color='0.5')\n",
    "    ph2.set_xlabel('offset from centre / kHz')\n",
    "    ph2.set_ylabel('residual / deg')\n",
    "    ph2.grid(color='0.85', lw=0.6); ph2.set_axisbelow(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
