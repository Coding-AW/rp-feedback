   "source": [
    "\n",
    "# =============================================================================\n",
    "#  STEP 0 - PREFLIGHT\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 0 - preflight')\n",
    "print('=' * 68)\n",
    "\n",
    "fail = []\n",
    "\n",
    "# --- 0a. build identifier ----------------------------------------------------\n",
    "bid = acq.build_id()\n",
    "print('build id                 : 0x%08X' % bid)\n",
    "if bid == 0:\n",
    "    fail.append('BUILD_ID is zero - this bitstream was not built by build_project.tcl')\n",
    "else:\n",
    "    print('  compare this against bitstream_id.txt, or run check_system.py')\n",
    "\n",
    "# --- 0b. do the acquisition registers respond? -------------------------------\n",
    "probe = 0x5A5A5A5A\n",
    "acq.w(0x04, probe)\n",
    "back = acq.r(0x04)\n",
    "print('local oscillator readback: wrote 0x%08X, read 0x%08X' % (probe, back))\n",
    "if back != probe:\n",
    "    fail.append('acquisition registers do not read back')\n",
    "\n",
    "# --- 0c. is the emulator present, or is this a stub? -------------------------\n",
    "probe18 = 0x15555                     # alternating bits, positive in 18 bits\n",
    "emu.w(0x04, probe18)\n",
    "back18 = emu.r(0x04) & 0x3FFFF\n",
    "print('emulator readback        : wrote 0x%05X, read 0x%05X' % (probe18, back18))\n",
    "if back18 != probe18:\n",
    "    fail.append('the emulator is absent or stubbed - Step 1 cannot run')\n",
    "\n",
    "# --- 0d. is the chain actually producing samples? ----------------------------\n",
    "acq.start(DEC_FIT)\n",
    "n0 = acq.r(0x20)\n",
    "time.sleep(0.10)\n",
    "n1 = acq.r(0x20)\n",
    "rate = (n1 - n0) / 0.10\n",
    "expect = FS_CLK / (1 << DEC_FIT)\n",
    "print('output rate              : %.0f samples/s (expected %.0f, %+.1f%%)'\n",
    "      % (rate, expect, 100.0 * (rate / expect - 1.0)))\n",
    "if not (0.8 * expect < rate < 1.25 * expect):\n",
    "    fail.append('output sample rate is wrong - check DEC_LOG2 and the clock')\n",
    "\n",
    "st2 = acq.status2()\n",
    "print('status2                  : 0x%02X  (overflow=%d corr_overrun=%d '\n",
    "      'corr_bypassed=%d write_err=%d)'\n",
    "      % (st2, st2 & 1, (st2 >> 1) & 1, (st2 >> 2) & 1, (st2 >> 3) & 1))\n",
    "if (st2 >> 2) & 1:\n",
    "    print('  NOTE: droop corrector bypassed - expected below R = 256 only')\n",
    "\n",
    "print('-' * 68)\n",
    "if fail:\n",
    "    for f in fail:\n",
    "        print('FAIL: %s' % f)\n",
    "    raise SystemExit('Step 0 failed - fix these before continuing')\n",
    "print('PASS - hardware answers and the chain is running')"
   ]
