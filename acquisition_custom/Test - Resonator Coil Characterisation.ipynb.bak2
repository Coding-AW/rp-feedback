    "\n",
    "# =============================================================================\n",
    "#  STEP 9b - SUMMARY\n",
    "# =============================================================================\n",
    "def _g(name, default=None):\n",
    "    \"\"\"Fetch a result that an earlier step may have skipped.\"\"\"\n",
    "    v = globals().get(name, default)\n",
    "    return default if v is None else v\n",
    "\n",
    "\n",
    "_qp = globals().get('Q_PHASE', None)\n",
    "_qr = globals().get('Q_RING', None)\n",
    "\n",
    "print('')\n",
    "print('=' * 68)\n",
    "print('BENCH COIL - SUMMARY')\n",
    "print('=' * 68)\n",
    "print('source                    : %s' % SOURCE_NOTE)\n",
    "print('measured                  : %s' % time.strftime('%Y-%m-%d %H:%M:%S'))\n",
    "print('bitstream build id        : 0x%08X' % acq.build_id())\n",
    "print('')\n",
    "print('centre frequency          : %.6f MHz' % (F0 / 1e6))\n",
    "print('linewidth                 : %.3f kHz' % (LW / 1e3))\n",
    "print('quality factor, swept     : %.1f' % Q_SWEEP)\n",
    "print('quality factor, phase     : %s'\n",
    "      % ('%.1f' % _qp if _qp else 'not obtained'))\n",
    "print('loop transport delay      : %s'\n",
    "      % ('%.0f ns' % (globals().get('TAU_LOOP') * 1e9)\n",
    "         if globals().get('TAU_LOOP') else 'not obtained'))\n",
    "print('quality factor, ring-down : %s'\n",
    "      % ('%.1f' % _qr if _qr else 'not obtained'))\n",
    "print('ring-down time constant   : %.3f us' % (1e6 * Q_SWEEP / (np.pi * F0)))\n",
    "print('')\n",
    "print('drive used                : %.3f of full scale' % DRIVE_FRAC)\n",
    "print('linear at that drive      : %s' % globals().get('LINEAR_OK', 'not tested'))\n",
    "print('drift                     : %s'\n",
    "      % ('%+.1f Hz/min (%.4f lw/min)'\n",
    "         % (_g('DRIFT_HZ_PER_MIN', float('nan')),\n",
    "            _g('DRIFT_HZ_PER_MIN', float('nan')) / LW)))\n",
    "print('scatter                   : %.1f Hz' % _g('SCATTER_HZ', float('nan')))\n",
    "print('')\n",
    "print('narrowing phase           : %.0f deg (loop-dependent, not portable)'\n",
    "      % _g('PHI_NARROW', float('nan')))\n",
    "print('K per unit gain           : %.3f' % _g('k_slope', float('nan')))\n",
    "print('extrapolated onset gain   : %.2f' % _g('A_ONSET', float('nan')))\n",
    "print('')\n",
    "print('receiver settings that worked')\n",
    "print('  decimation              : R = %d (log2 = %d)' % (1 << DEC_USE, DEC_USE))\n",
    "print('  output rate             : %.1f kHz' % (FS_CLK / (1 << DEC_USE) / 1e3))\n",
    "print('  clean window            : +-%.1f kHz' % (0.10 * FS_CLK / (1 << DEC_USE) / 1e3))\n",
    "print('=' * 68)\n",
    "\n",
    "# --- the agreement table: the closest thing to a known answer available here --\n",
    "print('')\n",
    "print('AGREEMENT BETWEEN INDEPENDENT METHODS')\n",
    "print('  method            Q        vs swept')\n",
    "print('  swept amplitude   %7.1f      -' % Q_SWEEP)\n",
    "if _qp:\n",
    "    print('  phase crossings   %7.1f   %+6.1f%%' % (_qp, 100 * (_qp / Q_SWEEP - 1)))\n",
    "if _qr:\n",
    "    print('  ring-down         %7.1f   %+6.1f%%' % (_qr, 100 * (_qr / Q_SWEEP - 1)))\n",
    "_spread = [q for q in (Q_SWEEP, _qp, _qr) if q]\n",
    "if len(_spread) >= 2:\n",
    "    _sp = (max(_spread) - min(_spread)) / np.mean(_spread)\n",
    "    print('  spread            %.1f%%' % (100 * _sp))\n",
    "    print('')\n",
    "    print('  %s' % ('CONSISTENT - take the swept value as the answer'\n",
    "                    if _sp < 0.15 else\n",
    "                    'INCONSISTENT - do not build on these numbers yet'))\n",
    "else:\n",
    "    print('')\n",
    "    print('  Only one method succeeded. That is the situation this notebook')\n",
    "    print('  exists to avoid - fix the failing method before going further.')"
   ]
  },
