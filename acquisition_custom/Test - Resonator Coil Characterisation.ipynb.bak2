   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  PHASE SHIFTER  -  base 0x40300000        (used only in Step 8)\n",
    "# =============================================================================\n",
    "#  Output = A cos(phi) x I  +  A sin(phi) x Q, where Q is the input delayed by a\n",
    "#  quarter of a period. The host does the trigonometry and writes two Q2.14\n",
    "#  coefficients. Two corrections, both from the module header:\n",
    "#\n",
    "#  1. The quarter-period delay D = fclk/(4f) is under one clock at 40 MHz, which\n",
    "#     is unbuildable, and a delay of zero is not allowed. Adding whole signal\n",
    "#     periods changes nothing physically, so use D = fclk/(4f) + k fclk/f and\n",
    "#     pick the k whose fractional part sits closest to 0 or 1, where the two-tap\n",
    "#     interpolator is most accurate.\n",
    "#  2. The datapath has a fixed THREE-sample latency - a pure transport delay of\n",
    "#     360 x 3 x f/fclk degrees. Subtracting it from the requested phase makes the\n",
    "#     delivered phase the requested one.\n",
    "#\n",
    "#     It was two samples until FIX 6 in red_pitaya_phaseshift.v registered the\n",
    "#     output sum to close a timing failure, taking the module from L = 2 to\n",
    "#     L = 3 and the loop delay from ~120 ns to ~128 ns. The module header and\n",
    "#     phaseshift_custom/validate_bram.py both say L = 3. One sample is 8 ns,\n",
    "#     which at 40 MHz is 115 DEGREES - so this constant being stale does not\n",
    "#     look like a small error, it rotates the whole phase axis.\n",
    "#\n",
    "#  BOTH corrections describe the DIGITAL path only. On a real coil the cables,\n",
    "#  the coil itself and any amplifier add more delay, which this cannot know\n",
    "#  about. Step 8 therefore never trusts the phase axis in absolute terms - it\n",
    "#  finds the interesting phases by measurement and reports everything relative\n",
    "#  to them.\n",
    "#\n",
    "#  \"Feedback off\" means coefficients (0, 0). NOT the bypass bit: bypass passes\n",
    "#  the input straight through, which is unity-gain feedback, not no feedback.\n",
    "# =============================================================================\n",
    "class PhaseShift(Bus):\n",
    "\n",
    "    LATENCY = 3      # datapath latency in samples (L = 3 since FIX 6; see above)\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40300000)\n",
    "        self.f_ref = None\n",
    "\n",
    "    def config_delay(self, f):\n",
    "        \"\"\"Programme the quarter-period delay line for frequency f.\"\"\"\n",
    "        best = None\n",
    "        for k in range(0, 9):\n",
    "            D = FS_CLK / (4.0 * f) + k * FS_CLK / f\n",
    "            if D < 1.0 or D > 1000.0:\n",
    "                continue\n",
    "            frac = D - np.floor(D)\n",
    "            score = min(frac, 1.0 - frac)       # interpolator error peaks at 0.5\n",
    "            if best is None or score < best[0]:\n",
    "                best = (score, int(np.floor(D)), frac)\n",
    "        if best is None:\n",
    "            raise ValueError('no usable quarter-period delay at %.3f MHz' % (f / 1e6))\n",
    "        self.w(0x08, best[1])                       # whole clocks\n",
    "        self.w(0x0C, int(round(best[2] * 16384)))   # fraction, Q0.14\n",
    "        self.w(0x10, 0)                             # bypass OFF\n",
    "        self.f_ref = f\n",
    "        return best[1], best[2]\n",
    "\n",
    "    def set(self, A, phi_deg):\n",
    "        \"\"\"Apply gain A and phase phi_deg (degrees).\"\"\"\n",
    "        if self.f_ref is None:\n",
    "            raise RuntimeError('call config_delay() first')\n",
    "        if not (0.0 <= A < 1.99):\n",
    "            # A x 16384 must stay inside int16. At A = 2.0 the coefficient is\n",
    "            # 32768, which wraps to -32768 and silently INVERTS the feedback.\n",
    "            raise ValueError('gain must be in [0, 1.99)')\n",
    "        phi = phi_deg - 360.0 * self.LATENCY * self.f_ref / FS_CLK\n",
    "        self.w(0x00, int(round(A * np.cos(np.radians(phi)) * 16384)) & 0xFFFF)\n",
    "        self.w(0x04, int(round(A * np.sin(np.radians(phi)) * 16384)) & 0xFFFF)\n",
    "\n",
    "    def off(self):\n",
    "        self.w(0x00, 0)\n",
    "        self.w(0x04, 0)\n",
    "\n",
    "\n",
    "ps = PhaseShift()\n",
    "ps.off()\n",
    "print('phase shifter mapped, feedback off')"
   ]
  },
