    "\n",
    "# =============================================================================\n",
    "#  STEP 5a - WIDTH FROM THE PHASE (independent of every amplitude effect)\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 5 - a second, independent width')\n",
    "print('=' * 68)\n",
    "\n",
    "LW_PHASE, TAU_LOOP, PH_RESID = width_from_phase(f3, z3, F0, LW)\n",
    "\n",
    "if LW_PHASE is None:\n",
    "    print('5a: the phase fit did not converge inside its search range.')\n",
    "    print('    Either the swing is too small (widen the Step 3 refine grid) or')\n",
    "    print('    the transport delay is beyond tau_max. Not a fault in the coil.')\n",
    "    Q_PHASE = None\n",
    "else:\n",
    "    Q_PHASE = F0 / LW_PHASE\n",
    "    print('5a  amplitude fit : linewidth = %.2f kHz, Q = %.1f' % (LW / 1e3, Q_SWEEP))\n",
    "    print('    phase fit     : linewidth = %.2f kHz, Q = %.1f'\n",
    "          % (LW_PHASE / 1e3, Q_PHASE))\n",
    "    print('    disagreement  : %+.1f%%' % (100 * (LW_PHASE / LW - 1.0)))\n",
    "    print('    fit residual  : %.2f degrees rms' % PH_RESID)\n",
    "    print('')\n",
    "    print('    transport delay through the whole loop : %.0f ns' % (TAU_LOOP * 1e9))\n",
    "    print('      for comparison, the digital path alone is about 128 ns, and')\n",
    "    print('      coaxial cable adds roughly 5 ns per metre. A number far outside')\n",
    "    print('      that range means the fit has found something else.')\n",
    "    if abs(LW_PHASE / LW - 1.0) > 0.15:\n",
    "        print('')\n",
    "        print('    WARNING: more than 15%% apart. The amplitude fit is the more')\n",
    "        print('    fragile of the two - suspect its baseline first.')\n",
    "    else:\n",
    "        print('    the two methods agree')\n",
    "\n",
    "# --- picture: measured phase against the fitted model ------------------------\n",
    "if LW_PHASE is not None:\n",
    "    _ph = np.unwrap(np.angle(z3))\n",
    "    _flip = -1.0 if np.polyfit(f3, _ph, 1)[0] > 0 else 1.0\n",
    "    _ph = _flip * _ph\n",
    "    _df = f3 - F0\n",
    "    _model = -2.0 * np.pi * abs(TAU_LOOP) * _df - np.arctan(2.0 * _df / LW_PHASE)\n",
    "    _ph = _ph - np.mean(_ph - _model)\n",
    "\n",
    "    fig, (ph1, ph2) = plt.subplots(2, 1, figsize=(7.2, 4.6), sharex=True,\n",
