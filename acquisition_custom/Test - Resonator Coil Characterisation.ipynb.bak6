    "# --- Step 8a picture ---------------------------------------------------------\n",
    "#  The differential curves are the measurement; the raw ones are shown faint\n",
    "#  behind them so a common-mode drift is visible for what it is.\n",
    "fig, (c1, c2) = plt.subplots(2, 1, figsize=(7.5, 5.4), sharex=True)\n",
    "\n",
    "_rel = (fb_phi[:half] - PHI_NARROW + 180.0) % 360.0 - 180.0\n",
    "_o = np.argsort(_rel)\n",
    "_relall = (fb_phi - PHI_NARROW + 180.0) % 360.0 - 180.0\n",
    "_oa = np.argsort(_relall)\n",
    "\n",
    "c1.plot(_relall[_oa], (fb_q[_oa] - np.nanmean(fb_q)) / Q_SWEEP * 100.0, '.',\n",
    "        ms=4, color='0.75', label='raw, mean removed')\n",
    "c1.plot(_rel[_o], dq[_o] / Q_SWEEP * 100.0, 'o-', ms=4, lw=1.1,\n",
    "        color=CLR_BLUE, label='differential, phi - (phi+180)')\n",
    "c1.axhline(0.0, ls=':', lw=1.0, color=CLR_GREY)\n",
    "if np.isfinite(Q_NOISE):\n",
    "    c1.axhspan(-300.0 * Q_NOISE / Q_SWEEP, 300.0 * Q_NOISE / Q_SWEEP,\n",
    "               color=CLR_RED, alpha=0.12, label='3x noise')\n",
    "c1.set_ylabel('Q change / % of Q0')\n",
    "c1.set_title('Step 8 - feedback at gain %.2f   [%s]'\n",
    "             % (FB_PROBE_USE,\n",
    "                'effect detected' if FB_DETECTED else 'NO effect above the noise'))\n",
    "c1.legend(fontsize=8)\n",
    "c1.grid(color='0.85', lw=0.6); c1.set_axisbelow(True)\n",
    "\n",
    "c2.plot(_relall[_oa], (fb_df[_oa] - np.nanmean(fb_df)) / LW, '.', ms=4, color='0.75')\n",
    "c2.plot(_rel[_o], ddf[_o] / LW, 'o-', ms=4, lw=1.1, color=CLR_ORANGE)\n",
    "c2.axhline(0.0, ls=':', lw=1.0, color=CLR_GREY)\n",
    "c2.set_xlabel('feedback phase relative to the narrowing phase / degrees')\n",
    "c2.set_ylabel('centre shift / linewidths')\n",
    "c2.grid(color='0.85', lw=0.6); c2.set_axisbelow(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "if FB_DETECTED:\n",
    "    print('The two curves should be a quarter turn apart: where the Q difference')\n",
    "    print('peaks the centre-shift difference crosses zero, and vice versa. The SIGN')\n",
    "    print('of the lower curve depends on how the feedback reaches the coil and is')\n",
    "    print('not expected to match the paper - their loop couples through a')\n",
    "    print('capacitor, this one sums into the drive.')\n",
    "else:\n",
    "    print('Both curves are consistent with zero. The shaded band is three times the')\n",
    "    print('measurement\\'s own point-to-point noise; a real feedback effect would')\n",
    "    print('leave it. Nothing here is a statement about the coil - it is a statement')\n",
    "    print('about how much gain survives two 0.3 pF capacitors.')\n"
   ]
