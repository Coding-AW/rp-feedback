   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  STEP 8a - THE PHASE AXIS: find the two special phases\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 8 - feedback on the real coil')\n",
    "print('=' * 68)\n",
    "\n",
    "acq.start(DEC_USE)\n",
    "whole, frac = ps.config_delay(F0)\n",
    "print('quarter-period delay line: %d whole clocks + %.3f' % (whole, frac))\n",
    "print('')\n",
    "\n",
    "# =============================================================================\n",
    "#  THE LOOP-GAIN BUDGET  -  read this before believing anything below it\n",
    "# =============================================================================\n",
    "#  The feedback path is  coil -> pickup cap -> IN1 -> x A -> OUT1 -> drive cap\n",
    "#  -> coil.  It crosses BOTH coupling capacitors, so the round trip carries the\n",
    "#  0.3 pF divider twice. Step 4 measured the one-way half of that as G_FWD, so\n",
    "#\n",
    "#       K  =  A x G_FWD\n",
    "#\n",
    "#  and the largest K available is at the largest coefficient the register holds.\n",
    "#  K = 1 is self-oscillation. On the emulator K reached 1 easily because the\n",
    "#  loop never left the chip. Here it may not be reachable at all - and if it is\n",
    "#  not, that is a real result about passive coupling, not a failure.\n",
    "# =============================================================================\n",
    "#  ---- how much feedback gain the converter can actually carry ----\n",
    "#  The generator and the feedback are summed digitally before the converter,\n",
    "#\n",
    "#       assign dac_a_sum = asg_dat[0] + pid_dat[0];\n",
    "#\n",
    "#  and that sum SATURATES. Coming off the top of it clips the drive into\n",
    "#  something that still fits like a resonance - this project's signature\n",
    "#  failure. The feedback contributes A x raw_peak of full scale, so the gain\n",
    "#  that fits in the headroom is a measured quantity, not a guess. Cap the gain\n",
    "#  to fit rather than refusing to run: the better the coupling, the more signal\n",
    "#  comes back, and the LESS gain the converter can carry. Those trade off\n",
    "#  against each other and the product - which is the loop gain - barely moves.\n",
    "_HEADROOM = 0.95 - DRIVE_FRAC\n",
    "if _HEADROOM <= 0.0:\n",
    "    raise RuntimeError('DRIVE_FRAC = %.2f leaves no converter headroom for any '\n",
    "                       'feedback at all. Lower it before running Step 8.'\n",
    "                       % DRIVE_FRAC)\n",
    "FB_GAIN_CEIL = float(min(FB_GAIN_MAX, _HEADROOM / max(raw_peak, 1e-9)))\n",
    "FB_PROBE_USE = float(min(FB_GAIN_PROBE, FB_GAIN_CEIL))\n",
    "FB_GAINS_USE = [a for a in FB_GAINS if a <= FB_GAIN_CEIL]\n",
    "# Always finish at the ceiling. Filtering the list alone threw away the top of\n",
    "# the range whenever headroom bit - a 1.90/1.50 pair dropped and the K-vs-gain\n",
    "# fit left with two points, which is a slope through almost nothing.\n",
    "if not FB_GAINS_USE or max(FB_GAINS_USE) < 0.98 * FB_GAIN_CEIL:\n",
    "    FB_GAINS_USE = FB_GAINS_USE + [round(FB_GAIN_CEIL, 3)]\n",
    "\n",
    "#  G_FWD_RES, not G_FWD. Feedback can only act on the part of the returning\n",
    "#  signal that actually came out of the resonator; anything that leaked around\n",
    "#  the coil is added back in and leaves again without ever touching it. Using\n",
    "#  the raw transfer here over-predicts the loop gain by exactly the leak's\n",
    "#  share, which is how a 4x \"shortfall\" gets manufactured out of nothing.\n",
    "K_MAX_POSSIBLE = FB_GAIN_CEIL * G_FWD_RES\n",
    "K_AT_PROBE = FB_PROBE_USE * G_FWD_RES\n",
    "print('loop-gain budget')\n",
    "print('  one-way transfer, all of it    : %.5f  (%.1f dB)'\n",
    "      % (G_FWD, 20 * np.log10(max(G_FWD, 1e-12))))\n",
    "print('  ...of which went via the coil  : %.5f  (%.1f dB)   <- what feedback acts on'\n",
    "      % (G_FWD_RES, 20 * np.log10(max(G_FWD_RES, 1e-12))))\n",
    "print('  ...leaked around it            : %.0f%% of the returning amplitude'\n",
    "      % (100 * (1.0 - G_FWD_RES / max(G_FWD, 1e-12))))\n",
    "print('  converter headroom for feedback: %.3f of full scale' % _HEADROOM)\n",
    "print('  largest gain that fits in it   : %.2f' % (_HEADROOM / max(raw_peak, 1e-9)))\n",
    "print('  gain ceiling actually used     : %.2f%s'\n",
    "      % (FB_GAIN_CEIL,\n",
    "         '  (capped by headroom, not by FB_GAIN_MAX = %.2f)' % FB_GAIN_MAX\n",
    "         if FB_GAIN_CEIL < FB_GAIN_MAX else '  (the register ceiling)'))\n",
    "print('  round trip at that ceiling     : K = %.4f' % K_MAX_POSSIBLE)\n",
    "print('  Q change that would produce    : %+.1f%%'\n",
    "      % (100 * (1.0 / (1.0 - min(K_MAX_POSSIBLE, 0.99)) - 1.0)))\n",
    "print('  K at the probe gain %.2f       : %.4f  (Q %+.1f%%)'\n",
    "      % (FB_PROBE_USE, K_AT_PROBE,\n",
    "         100 * (1.0 / (1.0 - min(K_AT_PROBE, 0.99)) - 1.0)))\n",
    "print('  drive + feedback at the DAC    : %.3f of full scale'\n",
    "      % (DRIVE_FRAC + FB_GAIN_CEIL * raw_peak))\n",
    "\n",
    "if K_MAX_POSSIBLE < 0.01:\n",
    "    print('')\n",
    "    print('  *** THIS SWEEP CANNOT SHOW A FEEDBACK EFFECT. ***')\n",
    "    print('  Even at the register ceiling the loop gain is %.4f, which moves Q by'\n",
    "          % K_MAX_POSSIBLE)\n",
    "    print('  %.1f%% - below what a Lorentzian fit resolves. The sweep will run and'\n",
    "          % (100 * K_MAX_POSSIBLE))\n",
    "    print('  return flat Q against phase. That IS the measurement: with both ports')\n",
    "    print('  coupled through %.1f pF there is not enough gain in the loop to move a'\n",
    "          % (C_COUPLE * 1e12))\n",
    "    print('  real coil, and an amplifier in the pickup path is what changes it.')\n",
    "elif K_MAX_POSSIBLE < 0.05:\n",
    "    print('')\n",
    "    print('  Marginal but workable: %.1f%% of Q at the ceiling. The differential'\n",
    "          % (100 * K_MAX_POSSIBLE))\n",
    "    print('  analysis below is what makes an effect this small readable.')\n",
    "else:\n",
    "    print('')\n",
    "    print('  Comfortable: %.1f%% of Q at the ceiling.' % (100 * K_MAX_POSSIBLE))\n",
    "print('')\n",
    "print('probing %d phases at gain %.2f, %d averages per point'\n",
    "      % (len(FB_PHASES), FB_PROBE_USE, FB_NAVG))\n",
    "print('')\n",
    "\n",
    "grid8 = F0 + np.linspace(-3.0, 3.0, 31) * LW     # wider: feedback moves the line\n",
    "\n",
    "fb_phi, fb_q, fb_df = [], [], []\n",
    "try:\n",
    "    for phi in FB_PHASES:\n",
    "        ps.set(FB_PROBE_USE, phi)\n",
    "        time.sleep(SETTLE)\n",
    "        gen.freq(F0); gen.amp(DRIVE_FRAC); gen.run(); time.sleep(0.02)\n",
    "        lvl = sc.peak_frac(GUARD_NSAMP)\n",
    "        gen.amp(0.0)\n",
    "        if lvl > FB_LEVEL_GUARD:\n",
    "            print('  %4d deg : ABANDONED, input at %.2f of full scale' % (phi, lvl))\n",
    "            fb_phi.append(phi); fb_q.append(np.nan); fb_df.append(np.nan)\n",
    "            continue\n",
    "        try:\n",
    "            f8, z8 = sweep(grid8, drive_frac=DRIVE_FRAC, navg=FB_NAVG,\n",
    "                           level_guard=FB_LEVEL_GUARD)\n",
    "            gen.amp(0.0)\n",
    "            fit8 = fit_or_raise(f8, np.abs(z8) ** 2, F0, LW,\n",
    "                                what='Step 8 fit at %d deg' % phi)\n",
    "            fb_phi.append(phi); fb_q.append(fit8['Q']); fb_df.append(fit8['f0'] - F0)\n",
    "            print('  %4d deg : Q = %7.1f  (x%.2f),  centre %+8.1f Hz (%+.3f lw)'\n",
    "                  % (phi, fit8['Q'], fit8['Q'] / Q_SWEEP, fb_df[-1], fb_df[-1] / LW))\n",
    "        except Exception as exc:\n",
    "            fb_phi.append(phi); fb_q.append(np.nan); fb_df.append(np.nan)\n",
    "            print('  %4d deg : fit failed (%s)' % (phi, exc))\n",
    "finally:\n",
    "    # The feedback loop is closed while this runs. Any exception, or\n",
    "    # a Ctrl-C between two phases, must not leave it that way.\n",
    "    ps.off()\n",
    "    gen.off()\n",
    "\n",
    "fb_phi = np.array(fb_phi, dtype=float)\n",
    "fb_q = np.array(fb_q, dtype=float)\n",
    "fb_df = np.array(fb_df, dtype=float)\n",
    "\n",
    "if np.all(~np.isfinite(fb_q)):\n",
    "    raise RuntimeError('every feedback point failed - check levels and coupling')\n",
    "\n",
    "# =============================================================================\n",
    "#  DIFFERENTIAL ANALYSIS  -  phi against phi + 180\n",
    "# =============================================================================\n",
    "#  Taking argmax of the raw Q curve is what produced the earlier nonsense: with\n",
    "#  the effect below the fit noise it returns whichever phase happened to fit\n",
    "#  highest, and then reports it as \"the narrowing phase\" with no way of telling\n",
    "#  that it is meaningless.\n",
    "#\n",
    "#  Feedback is ANTISYMMETRIC in phase: whatever narrows the line at phi\n",
    "#  broadens it at phi + 180. Every error that matters here is not - a slow drift\n",
    "#  in f0, a bias from the baseline, a drive level that sagged during the scan\n",
    "#  all land on both members of a pair identically. So subtract the pair. The\n",
    "#  common-mode error cancels, the signal doubles, and what is left can be\n",
    "#  compared against the measurement's own noise to decide whether it is real.\n",
    "# =============================================================================\n",
    "half = len(fb_phi) // 2\n",
    "_opp = np.array([int(np.argmin(np.abs(((fb_phi - (p + 180.0)) + 180.0) % 360.0 - 180.0)))\n",
    "                 for p in fb_phi[:half]])\n",
    "dq = fb_q[:half] - fb_q[_opp]            # antisymmetric: the feedback signature\n",
    "ddf = fb_df[:half] - fb_df[_opp]\n",
    "\n",
    "# ---- fit a cosine, do not take an argmax ------------------------------------\n",
    "#  Theory says the differential IS a cosine: dq(phi) = D cos(phi - phi_narrow).\n",
    "#  An argmax over a 20-degree grid can only ever return a grid point, it is\n",
    "#  biased towards the ends of the half-turn, and it throws away eight of the\n",
    "#  nine measurements. A two-parameter least-squares fit uses all of them and\n",
    "#  locates the phase to a fraction of a degree. This matters: an argmax that\n",
    "#  reports 0 and 60 degrees for two effects that are physically a quarter turn\n",
    "#  apart is not a marginal result, it is an under-resolved one.\n",
    "def _fit_cos(phi_deg, y):\n",
    "    \"\"\"Least-squares fit of y = D cos(phi - phi0). Returns (D, phi0_deg).\"\"\"\n",
    "    good = np.isfinite(y)\n",
    "    if int(np.count_nonzero(good)) < 3:\n",
    "        return float('nan'), float('nan')\n",
    "    p = np.radians(np.asarray(phi_deg, dtype=float)[good])\n",
    "    basis = np.column_stack([np.cos(p), np.sin(p)])\n",
    "    coef, _, _, _ = np.linalg.lstsq(basis, np.asarray(y, dtype=float)[good], rcond=-1)\n",
    "    return float(np.hypot(coef[0], coef[1])), float(np.degrees(np.arctan2(coef[1], coef[0])))\n",
    "\n",
    "DQ_AMP, PHI_NARROW = _fit_cos(fb_phi[:half], dq)\n",
    "DDF_AMP, PHI_SHIFT = _fit_cos(fb_phi[:half], ddf)\n",
    "PHI_NARROW = float(PHI_NARROW % 360.0)\n",
    "PHI_SHIFT = float(PHI_SHIFT % 360.0)\n",
    "PHI_BROAD = (PHI_NARROW + 180.0) % 360.0\n",
    "\n",
    "# Noise from successive differences along a curve that should be smooth: the\n",
    "# measurement declaring its own error bar rather than us assuming one.\n",
    "_fin = fb_q[np.isfinite(fb_q)]\n",
    "Q_NOISE = float(np.std(np.diff(_fin)) / np.sqrt(2.0)) if len(_fin) > 2 else float('nan')\n",
    "Q_SIGNAL = DQ_AMP / 2.0\n",
    "FB_DETECTED = bool(np.isfinite(Q_NOISE) and DQ_AMP > 3.0 * Q_NOISE)\n",
    "\n",
    "# The differential swings by 2 K Q0 peak-to-peak-over-two, because feedback\n",
    "# narrows at phi and broadens at phi+180 by the same amount. So K is HALF the\n",
    "# fractional modulation - reporting the modulation next to a predicted K was\n",
    "# comparing two different quantities and made the shortfall look twice as bad\n",
    "# as it is.\n",
    "K_MEASURED = float(DQ_AMP / (2.0 * Q_SWEEP))\n",
    "\n",
    "print('')\n",
    "print('  differential amplitude       : %.2f%% of Q0 (= 2K)' % (100 * DQ_AMP / Q_SWEEP))\n",
    "print('  MEASURED K                   : %.4f' % K_MEASURED)\n",
    "print('  predicted K, resonant only   : %.4f' % K_AT_PROBE)\n",
    "print('  (what the raw transfer would have predicted, leak included : %.4f -'\n",
    "      % (FB_PROBE_USE * G_FWD))\n",
    "print('   that overestimate is the leak, and it is why the budget and the')\n",
    "print('   measurement used to disagree by a factor of several)')\n",
    "print('  point-to-point Q noise       : %.2f%% of Q0' % (100 * Q_NOISE / Q_SWEEP))\n",
    "print('  signal-to-noise              : %.1f' % (DQ_AMP / max(Q_NOISE, 1e-12)))\n",
    "print('')\n",
    "\n",
    "if not FB_DETECTED:\n",
    "    print('  NO FEEDBACK EFFECT DETECTED - and the phases below are meaningless.')\n",
    "    print('  The modulation is under three times the noise, so the \"narrowing')\n",
    "    print('  phase\" is just wherever the noise peaked. Do NOT read it as physics,')\n",
    "    print('  and do not read Step 8b\\'s K either.')\n",
    "    print('')\n",
    "    if K_MAX_POSSIBLE < 0.01:\n",
    "        print('  This agrees with the budget above: the loop simply has no gain.')\n",
    "        print('  The fix is not in this notebook. Either put a low-noise amplifier')\n",
    "        print('  in the pickup path before IN1, or couple more strongly than')\n",
    "        print('  %.1f pF - both of which change the divider, and with it every' % (C_COUPLE * 1e12))\n",
    "        print('  number Step 4 predicted.')\n",
    "    else:\n",
    "        print('  The budget said an effect SHOULD be visible, so this disagreement')\n",
    "        print('  is worth chasing: check the delay line configured above, check')\n",
    "        print('  that the phase shifter is not bypassed, and re-run Step 4 to')\n",
    "        print('  confirm the coupling has not changed.')\n",
    "else:\n",
    "    print('  narrowing phase (cosine fit)   : %.1f deg' % PHI_NARROW)\n",
    "    print('  broadening phase (opposite)    : %.1f deg' % PHI_BROAD)\n",
    "    print('  largest centre shift at        : %.1f deg' % PHI_SHIFT)\n",
    "    _sep = (PHI_SHIFT - PHI_NARROW) % 360.0\n",
    "    print('  separation between them        : %.1f deg  (theory: 90 or 270)' % _sep)\n",
    "    _off = min(abs(_sep - 90.0), abs(_sep - 270.0))\n",
    "    if _off > 35.0:\n",
    "        print('  WARNING: the two effects should be a quarter turn apart and are')\n",
    "        print('  %.0f degrees off it. At a signal-to-noise of %.1f that is unlikely'\n",
    "              % (_off, DQ_AMP / max(Q_NOISE, 1e-12)))\n",
    "        print('  to be scatter - suspect the loop compressing, or a second path')\n",
    "        print('  with its own phase (see the leakage figure in Step 4).')\n",
    "    else:\n",
    "        print('  -> a quarter turn, as theory demands. The phase axis is sound.')\n",
    "\n",
    "    _ratio = K_MEASURED / max(FB_PROBE_USE * G_FWD_RES, 1e-12)\n",
    "    print('')\n",
    "    print('  measured K / resonant prediction : %.2fx' % _ratio)\n",
    "    if 0.5 < _ratio < 2.0:\n",
    "        print('  -> the loop gain is what the coupling says it should be. The')\n",
    "        print('     budget and the measurement agree once leakage is taken out.')\n",
    "    else:\n",
    "        print('  -> these disagree by more than a factor of two. Re-check the leak')\n",
    "        print('     figure in Step 4 and the coupling capacitor values.')"
   ]
  },
