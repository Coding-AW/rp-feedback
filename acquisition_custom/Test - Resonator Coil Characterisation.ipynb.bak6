    "\n",
    "# NOT d_f0: Step 7 uses that name for its array of fitted centres.\n",
    "d_f0_spread = (_f0s.max() - _f0s.min()) / LW\n",
    "d_q = (_qs.max() - _qs.min()) / _qs.mean()\n",
    "# a linear system's peak power scales as the square of the drive\n",
