   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  SIGNAL GENERATOR  -  base 0x40200000, stock Red Pitaya module\n",
    "# =============================================================================\n",
    "#  It replays a 16384-entry table at a programmable rate. Load one sine cycle\n",
    "#  once; the frequency is then a single register write. The read pointer carries\n",
    "#  16 fractional bits, so a full cycle spans 16384 x 2**16 = 2**30 pointer units:\n",
    "#\n",
    "#      f = step x 125e6 / 2**30          (about 0.116 Hz per step)\n",
    "#\n",
    "#  At 40 MHz the pointer advances roughly 5200 table entries per clock, so the\n",
    "#  table is read very sparsely - that is fine and is exactly what producing a\n",
    "#  40 MHz sine from a 125 MHz converter means.\n",
    "#\n",
    "#  Register recipe: 0x04 amplitude (0x2000 = x1.0), 0x08 table size, 0x0C start\n",
    "#  offset, 0x10 step, table at 0x10000. Control 0x00: bit 6 resets the pointer,\n",
    "#  0x11 = free-run with wraparound, 0xC0 = held in reset with the output at zero.\n",
    "# =============================================================================\n",
    "class Generator(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40200000, span=0x20000)\n",
    "        self._step = None\n",
    "\n",
    "    def load_sine(self):\n",
    "        \"\"\"Write one cycle of a sine into the table. Takes a second or two:\n",
    "        16384 single-word writes, and single-word is not negotiable here.\"\"\"\n",
    "        for i in range(16384):\n",
    "            v = int(round(8191.0 * np.sin(2.0 * np.pi * i / 16384.0)))\n",
    "            self.w(0x10000 + 4 * i, v & 0x3FFF)\n",
    "        self.w(0x08, (16384 << 16) - 1)     # table size, fixed point, inclusive\n",
    "        self.w(0x0C, 0)                     # start replaying from entry 0\n",
    "\n",
    "    def freq_word(self, f):\n",
    "        \"\"\"Nearest 30-bit frequency word to f hertz.\"\"\"\n",
    "        return int(round(f / FS_CLK * (1 << 30)))\n",
    "\n",
    "    def set_word(self, step):\n",
    "        \"\"\"Set frequency by raw word; return the frequency actually produced.\"\"\"\n",
    "        self._step = int(step)\n",
    "        self.w(0x10, self._step)\n",
    "        return self._step * FS_CLK / float(1 << 30)\n",
    "\n",
    "    def freq(self, f):\n",
    "        \"\"\"Set frequency in hertz; return the frequency actually produced.\"\"\"\n",
    "        return self.set_word(self.freq_word(f))\n",
    "\n",
    "    def lo_word(self):\n",
    "        \"\"\"The 32-bit local-oscillator word that lands this signal EXACTLY at\n",
    "        0 Hz. The generator counts in units of 2**-30 of the clock and the local\n",
    "        oscillator in units of 2**-32, so the conversion is a factor of four and\n",
    "        carries no rounding error at all.\"\"\"\n",
    "        return 4 * self._step\n",
    "\n",
    "    def amp(self, frac):\n",
    "        \"\"\"Output amplitude as a fraction of full scale. CLAMPED, deliberately.\n",
    "\n",
    "        The register is Q1.13 with 0x2000 = x1.0, and it happily accepts up to\n",
    "        0x3FFF = x1.9999. The write below is masked with & 0x3FFF, so before this\n",
    "        guard existed the mask turned mistakes into silent, WRONG drive levels:\n",
    "\n",
    "            frac = -0.5  ->  0x3000  ->  x1.5   (a sign slip drives 50% HARDER)\n",
    "            frac =  2.0  ->  0x0000  ->  x0.0   (silence, and no complaint)\n",
    "            frac =  1.5  ->  0x3000  ->  x1.5   (clipped square wave, not a sine)\n",
    "\n",
    "        Every one of those is silent on the bench. Anything outside\n",
    "        [0, DRIVE_MAX] is now refused instead, so the only way to drive the coil\n",
    "        harder is to raise DRIVE_MAX in the configuration cell on purpose.\"\"\"\n",
    "        frac = float(frac)\n",
    "        if not np.isfinite(frac):\n",
    "            raise ValueError('drive amplitude is not a finite number: %r' % frac)\n",
    "        if frac < 0.0:\n",
    "            raise ValueError(\n",
    "                'negative drive amplitude (%.4f). A sign has no meaning here, and '\n",
    "                'the register would silently wrap it to x%.4f.'\n",
    "                % (frac, (int(round(frac * 8192)) & 0x3FFF) / 8192.0))\n",
    "        if frac > DRIVE_MAX:\n",
    "            raise ValueError(\n",
    "                'drive %.4f exceeds DRIVE_MAX = %.4f. Nothing in this notebook '\n",
    "                'may drive harder than the ceiling; raise it in the configuration '\n",
    "                'cell if that is really what you want.' % (frac, DRIVE_MAX))\n",
    "        self.w(0x04, int(round(frac * 8192)) & 0x3FFF)\n",
    "\n",
    "    def run(self):\n",
    "        self.w(0x00, 0x40)      # reset the read pointer\n",
    "        self.w(0x00, 0x11)      # free-run, wrap at the end of the table\n",
    "\n",
    "    def off(self):\n",
    "        self.amp(0.0)\n",
    "        self.w(0x00, 0xC0)      # held in reset, output forced to zero\n",
    "\n",
    "\n",
    "gen = Generator()\n",
    "gen.off()\n",
    "gen.load_sine()\n",
    "print('generator ready, table loaded, output off')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  PHASE SHIFTER  -  base 0x40300000        (used only in Step 8)\n",
    "# =============================================================================\n",
    "#  Output = A cos(phi) x I  +  A sin(phi) x Q, where Q is the input delayed by a\n",
    "#  quarter of a period. The host does the trigonometry and writes two Q2.14\n",
    "#  coefficients. Two corrections, both from the module header:\n",
    "#\n",
    "#  1. The quarter-period delay D = fclk/(4f) is under one clock at 40 MHz, which\n",
    "#     is unbuildable, and a delay of zero is not allowed. Adding whole signal\n",
    "#     periods changes nothing physically, so use D = fclk/(4f) + k fclk/f and\n",
    "#     pick the k whose fractional part sits closest to 0 or 1, where the two-tap\n",
    "#     interpolator is most accurate.\n",
    "#  2. The datapath has a fixed THREE-sample latency - a pure transport delay of\n",
    "#     360 x 3 x f/fclk degrees. Subtracting it from the requested phase makes the\n",
    "#     delivered phase the requested one.\n",
    "#\n",
    "#     It was two samples until FIX 6 in red_pitaya_phaseshift.v registered the\n",
    "#     output sum to close a timing failure, taking the module from L = 2 to\n",
    "#     L = 3 and the loop delay from ~120 ns to ~128 ns. The module header and\n",
    "#     phaseshift_custom/validate_bram.py both say L = 3. One sample is 8 ns,\n",
    "#     which at 40 MHz is 115 DEGREES - so this constant being stale does not\n",
    "#     look like a small error, it rotates the whole phase axis.\n",
    "#\n",
    "#  BOTH corrections describe the DIGITAL path only. On a real coil the cables,\n",
    "#  the coil itself and any amplifier add more delay, which this cannot know\n",
    "#  about. Step 8 therefore never trusts the phase axis in absolute terms - it\n",
    "#  finds the interesting phases by measurement and reports everything relative\n",
    "#  to them.\n",
    "#\n",
    "#  \"Feedback off\" means coefficients (0, 0). NOT the bypass bit: bypass passes\n",
    "#  the input straight through, which is unity-gain feedback, not no feedback.\n",
    "# =============================================================================\n",
    "class PhaseShift(Bus):\n",
    "\n",
    "    LATENCY = 3      # datapath latency in samples (L = 3 since FIX 6; see above)\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40300000)\n",
    "        self.f_ref = None\n",
    "\n",
    "    def config_delay(self, f):\n",
    "        \"\"\"Programme the quarter-period delay line for frequency f.\"\"\"\n",
    "        best = None\n",
    "        for k in range(0, 9):\n",
    "            D = FS_CLK / (4.0 * f) + k * FS_CLK / f\n",
    "            if D < 1.0 or D > 1000.0:\n",
    "                continue\n",
    "            frac = D - np.floor(D)\n",
    "            score = min(frac, 1.0 - frac)       # interpolator error peaks at 0.5\n",
    "            if best is None or score < best[0]:\n",
    "                best = (score, int(np.floor(D)), frac)\n",
    "        if best is None:\n",
    "            raise ValueError('no usable quarter-period delay at %.3f MHz' % (f / 1e6))\n",
    "        self.w(0x08, best[1])                       # whole clocks\n",
    "        self.w(0x0C, int(round(best[2] * 16384)))   # fraction, Q0.14\n",
    "        self.w(0x10, 0)                             # bypass OFF\n",
    "        self.f_ref = f\n",
    "        return best[1], best[2]\n",
    "\n",
    "    def set(self, A, phi_deg):\n",
    "        \"\"\"Apply gain A and phase phi_deg (degrees).\"\"\"\n",
    "        if self.f_ref is None:\n",
    "            raise RuntimeError('call config_delay() first')\n",
    "        if not (0.0 <= A < 1.99):\n",
    "            # A x 16384 must stay inside int16. At A = 2.0 the coefficient is\n",
    "            # 32768, which wraps to -32768 and silently INVERTS the feedback.\n",
    "            raise ValueError('gain must be in [0, 1.99)')\n",
    "        phi = phi_deg - 360.0 * self.LATENCY * self.f_ref / FS_CLK\n",
    "        self.w(0x00, int(round(A * np.cos(np.radians(phi)) * 16384)) & 0xFFFF)\n",
    "        self.w(0x04, int(round(A * np.sin(np.radians(phi)) * 16384)) & 0xFFFF)\n",
    "\n",
    "    def off(self):\n",
    "        self.w(0x00, 0)\n",
    "        self.w(0x04, 0)\n",
    "\n",
    "\n",
    "ps = PhaseShift()\n",
    "ps.off()\n",
    "print('phase shifter mapped, feedback off')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  DIGITAL RESONATOR (THE EMULATOR)  -  base 0x40400000\n",
    "# =============================================================================\n",
    "#  Used in ONE place in this notebook: Step 1, to prove the instrument still\n",
    "#  returns an answer it was given, before and after the real measurements.\n",
    "#\n",
    "#  It is a register bit, not a cable. Enabled, it REPLACES the digitised input,\n",
    "#  so the coil can stay connected and simply be ignored. That means the\n",
    "#  known-answer check is available at any moment, including in the middle of a\n",
    "#  bench session - which is the single most useful safety net available here.\n",
    "#\n",
    "#  Coefficients: c = r cos(w0) x 2**17, s = r sin(w0) x 2**17, with\n",
    "#  w0 = 2 pi f0 / 125e6 and r = 1 - pi (f0/125e6) / Q. Rounding those to 18-bit\n",
    "#  integers moves the pole slightly, so the QUANTISED values - recovered below\n",
    "#  as f0_q and q_q - are the real known answer, not the numbers asked for.\n",
    "# =============================================================================\n",
    "class Emulator(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40400000)\n",
    "        self.f0_q = None\n",
    "        self.q_q = None\n",
    "\n",
    "    def config(self, f0, Q, delay=15, oshift=7):\n",
    "        w0 = 2.0 * np.pi * f0 / FS_CLK\n",
    "        r = 1.0 - np.pi * (f0 / FS_CLK) / Q\n",
    "        ci = int(round(r * np.cos(w0) * 131072))\n",
    "        cs = int(round(r * np.sin(w0) * 131072))\n",
    "        self.w(0x04, ci & 0x3FFFF)\n",
    "        self.w(0x08, cs & 0x3FFFF)\n",
    "        self.w(0x0C, delay)      # 15 clocks = the board's real 119.87 ns loop\n",
    "        self.w(0x10, oshift)\n",
    "        rq = np.hypot(ci, cs) / 131072.0\n",
    "        self.f0_q = np.arctan2(cs, ci) / (2.0 * np.pi) * FS_CLK\n",
    "        self.q_q = np.pi * (self.f0_q / FS_CLK) / (1.0 - rq)\n",
    "        return self.f0_q, self.q_q\n",
    "\n",
    "    def enable(self):\n",
    "        self.w(0x00, 1)\n",
    "\n",
    "    def disable(self):\n",
    "        self.w(0x00, 0)\n",
    "\n",
    "    def clear(self):\n",
    "        self.w(0x00, 3)          # zero the state and the sticky clip flag\n",
    "\n",
    "    def enabled(self):\n",
    "        return bool(self.r(0x00) & 1)\n",
    "\n",
    "    def clipped(self):\n",
    "        return bool(self.r(0x14) & 1)\n",
    "\n",
    "\n",
    "emu = Emulator()\n",
    "emu.disable()\n",
    "print('emulator mapped and DISABLED (the board is listening to its real input)')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  INTERNAL SCOPE  -  base 0x40100000\n",
    "# =============================================================================\n",
    "#  Captures 16384 samples of the RAW input at up to the full 125 MSa/s. Two jobs\n",
    "#  here, neither of which the acquisition chain can do:\n",
    "#\n",
    "#   * LEVEL CHECK. There is no input-overload detection anywhere in this design.\n",
    "#     The emulator has a sticky clip flag, but that is the emulator's, and it is\n",
    "#     gone the moment you measure a real coil. This is the only guard.\n",
    "#   * WAVEFORM CHECK. The decimated chain reports one complex number per\n",
    "#     tuning; only the raw path can show what the input actually looks like.\n",
    "#\n",
    "#  The equalisation filter this block once carried has been REMOVED from the\n",
    "#  design (1173 timing violations, and switched off anyway). Its coefficient\n",
    "#  registers still accept writes and do nothing. For these measurements that is\n",
    "#  an improvement: the scope is now a flat, unmodified path.\n",
    "#\n",
    "#  It sees the same signal the rest of the chain does - so with the emulator\n",
    "#  enabled it shows the emulator, not the input.\n",
    "# =============================================================================\n",
    "SC_BASE = 0x40100000\n",
    "SC_SPAN = 0x40000\n",
    "SC_BUF_A = 0x10000\n",
    "SC_BUF_B = 0x20000\n",
    "SC_NMAX = 1 << 14\n",
    "\n",
    "\n",
    "class Scope(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, SC_BASE, span=SC_SPAN)\n",
    "\n",
    "    def _buf(self, off, n):\n",
    "        \"\"\"Read n samples, one 32-bit word at a time (this is a register block,\n",
    "        not DDR). The buffer holds 14-bit two's-complement values.\"\"\"\n",
    "        ba = bytearray(4 * n)\n",
    "        m = self.m\n",
    "        for i in range(n):\n",
    "            o = off + 4 * i\n",
    "            ba[4 * i:4 * i + 4] = m[o:o + 4]\n",
    "        v = np.frombuffer(bytes(ba), dtype='<u4').astype(np.int64) & 0x3FFF\n",
    "        return np.where(v & 0x2000, v - 0x4000, v).astype(float)\n",
    "\n",
    "    def acquire(self, dec=1, n=SC_NMAX, chan='A'):\n",
    "        \"\"\"Capture and return (samples, sample_rate). dec = 1 is every sample.\"\"\"\n",
    "        self.w(0x14, dec)\n",
    "        self.w(0x10, n - 1)\n",
    "        self.w(0x00, 2)        # reset the capture engine\n",
    "        self.w(0x00, 1)        # arm\n",
    "        self.w(0x04, 1)        # trigger now, from software\n",
    "        t0 = time.time()\n",
    "        while self.r(0x04) != 0:\n",
    "            if time.time() - t0 > 1.0:\n",
    "                break\n",
    "        time.sleep(0.005)\n",
    "        off = SC_BUF_A if chan == 'A' else SC_BUF_B\n",
    "        return self._buf(off, n), FS_CLK / float(dec)\n",
    "\n",
    "    def peak_frac(self, n=4096):\n",
    "        \"\"\"Peak input level as a fraction of full scale. 1.0 means clipping.\"\"\"\n",
    "        x, _ = self.acquire(dec=1, n=n)\n",
    "        return float(np.max(np.abs(x))) / 8191.0\n",
    "\n",
    "\n",
    "sc = Scope()\n",
    "print('scope mapped, %d samples per capture' % SC_NMAX)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "#  ALL_OFF  -  the one call that makes the hardware harmless\n",
    "# =============================================================================\n",
    "#  Every step below that raises the drive does so inside a try/finally that ends\n",
    "#  here, so an exception, a failed fit or an interrupted cell cannot leave the\n",
    "#  coil being driven with the feedback loop closed. It is also registered to run\n",
    "#  when the kernel shuts down.\n",
    "#\n",
    "#  Safe to call at any time, including twice, including when nothing is running.\n",
    "#  If anything ever looks wrong on the bench, run all_off() in a fresh cell.\n",
    "# =============================================================================\n",
    "def all_off():\n",
    "    \"\"\"Silence the drive, open the feedback loop, disable the emulator.\"\"\"\n",
    "    for what, fn in (('generator', lambda: gen.off()),\n",
    "                     ('feedback', lambda: ps.off()),\n",
    "                     ('emulator', lambda: emu.disable())):\n",
    "        try:\n",
    "            fn()\n",
    "        except Exception as exc:\n",
    "            # One block failing to switch off must never stop the others being\n",
    "            # switched off - the generator is the one that matters.\n",
    "            print('all_off: could not switch off the %s (%s)' % (what, exc))\n",
    "\n",
    "\n",
    "import atexit\n",
    "atexit.register(all_off)\n",
    "all_off()\n",
    "print('all_off() defined and armed - drive, feedback and emulator are all off')"
   ]
