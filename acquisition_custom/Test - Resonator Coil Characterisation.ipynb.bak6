    "#  STEP 5 - THE SAME WIDTH, THROUGH A DIFFERENT RECEIVER\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 5 - a second, independent width')\n",
    "print('=' * 68)\n",
    "\n",
    "DEC_ALT = int(min(12, DEC_USE + 1))\n",
    "if DEC_ALT == DEC_USE:\n",
    "    DEC_ALT = int(max(8, DEC_USE - 1))\n",
    "\n",
    "print('primary   : R = %5d, clean window +-%6.1f kHz  (%.1f%% of a linewidth)'\n",
    "      % (1 << DEC_USE, 0.10 * FS_CLK / (1 << DEC_USE) / 1e3,\n",
    "         100 * 0.10 * FS_CLK / (1 << DEC_USE) / LW))\n",
    "print('alternate : R = %5d, clean window +-%6.1f kHz  (%.1f%% of a linewidth)'\n",
    "      % (1 << DEC_ALT, 0.10 * FS_CLK / (1 << DEC_ALT) / 1e3,\n",
    "         100 * 0.10 * FS_CLK / (1 << DEC_ALT) / LW))\n",
    "print('')\n",
    "\n",
    "acq.start(DEC_ALT)\n",
    "grid5 = F0 + np.linspace(-2.5, 2.5, 61) * LW\n",
    "f5, z5 = sweep(grid5, drive_frac=DRIVE_FRAC, navg=N_AVG, level_guard=0.95)\n",
    "acq.start(DEC_USE)                       # put the receiver back\n",
    "\n",
    "try:\n",
    "    FIT_ALT = fit_or_raise(f5, np.abs(z5) ** 2, F0, LW, what='Step 5 alternate-decimation fit')\n",
    "    LW_ALT = FIT_ALT['lw']\n",
    "    Q_ALT = FIT_ALT['Q']\n",
    "    _rel = LW_ALT / LW - 1.0\n",
    "    print('  width at R = %-5d : %.2f kHz, Q = %.1f' % (1 << DEC_USE, LW / 1e3, Q_SWEEP))\n",
    "    print('  width at R = %-5d : %.2f kHz, Q = %.1f' % (1 << DEC_ALT, LW_ALT / 1e3, Q_ALT))\n",
    "    print('  centre moved by    : %+.2f kHz  (%+.3f linewidths)'\n",
    "          % ((FIT_ALT['f0'] - F0) / 1e3, (FIT_ALT['f0'] - F0) / LW))\n",
    "    print('  disagreement       : %+.1f%%' % (100 * _rel))\n",
    "    print('  leak seen by each  : %.3f and %.3f' % (LEAK_FRAC, FIT_ALT['leak_frac']))\n",
    "    print('-' * 68)\n",
    "    if abs(_rel) <= 0.10:\n",
    "        print('  AGREE - the width is the coil\\'s, not the receiver\\'s')\n",
    "    else:\n",
    "        print('  DISAGREE by more than 10%. The receiver window is shaping the')\n",
    "        print('  measurement. Raise the decimation (DEC_FIT / choose_dec) until')\n",
    "        print('  the two agree, and re-run Step 3 before trusting Q.')\n",
    "except Exception as exc:\n",
    "    LW_ALT = Q_ALT = None\n",
    "    print('  the alternate-decimation fit refused: %s' % exc)\n",
    "    print('  No second width. Treat Q as unconfirmed.')\n"
   ]
