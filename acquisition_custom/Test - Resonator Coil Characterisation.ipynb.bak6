    "\n",
    "# --- pass 2: bracket ---------------------------------------------------------\n",
    "#  Widen until the curve comes down on BOTH sides. Each attempt doubles the\n",
    "#  span. Stopping as soon as both flanks are below half the peak is what makes\n",
    "#  the later fit an interpolation rather than an extrapolation.\n",
    "# =============================================================================\n",
    "span = 6.0 * SEARCH_STEP\n",
    "f_c = f1[k1]\n",
    "lw_guess = None\n",
    "for attempt in range(5):\n",
    "    grid2 = f_c + np.linspace(-span, span, 41)\n",
    "    grid2 = grid2[(grid2 > 1.0e6) & (grid2 < 0.49 * FS_CLK)]\n",
    "    f2, z2 = sweep(grid2, drive_frac=DRIVE_FRAC, navg=24, settle=0.008,\n",
    "                   level_guard=0.95)\n",
    "    gen.amp(0.0)\n",
    "    p2 = np.abs(z2) ** 2\n",
    "    base2 = float(np.median(p2))\n",
    "    half = base2 + 0.5 * (float(np.max(p2)) - base2)\n",
    "    down_both = (p2[0] < half) and (p2[-1] < half)\n",
    "    f_c = float(f2[int(np.argmax(p2))])\n",
    "    lw_guess = half_power_width(f2, p2)\n",
    "    print('pass 2 attempt %d: span +-%.1f kHz, centre %.4f MHz, '\n",
    "          'flanks down both sides: %s'\n",
    "          % (attempt + 1, span / 1e3, f_c / 1e6, down_both))\n",
    "    if down_both and lw_guess:\n",
    "        break\n",
    "    span *= 2.0\n",
    "\n",
    "if lw_guess is None:\n",
    "    raise RuntimeError('could not bracket a resonance - widen SEARCH or check coupling')\n",
    "print('        rough linewidth %.1f kHz  ->  rough Q %.0f'\n",
    "      % (lw_guess / 1e3, f_c / lw_guess))"
