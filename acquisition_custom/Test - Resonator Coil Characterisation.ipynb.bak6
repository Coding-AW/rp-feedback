    "# =============================================================================\n",
    "#  STEP 6 - LINEARITY\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 6 - linearity against drive level')\n",
    "print('=' * 68)\n",
    "\n",
    "acq.start(DEC_USE)\n",
    "grid6 = F0 + np.linspace(-3.0, 3.0, 41) * LW   # wings carry the leak phase\n",
    "\n",
    "lin_rows = []\n",
    "for frac in DRIVE_FRACS_LIN:\n",
    "    f6, z6 = sweep(grid6, drive_frac=frac, navg=N_AVG, level_guard=0.95)\n",
    "    gen.amp(0.0)\n",
    "    # Fano fit: the leak is present at every drive level, and a symmetric\n",
    "    # fit reads its interference as a change in the coil.\n",
    "    fit6 = fit_or_raise(f6, np.abs(z6) ** 2, F0, LW,\n",
