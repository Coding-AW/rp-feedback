    "print('        best candidate %.4f MHz, %.1f dB above the median'\n",
    "      % (f1[k1] / 1e6, contrast_db))\n",
    "if contrast_db < 6.0:\n",
    "    print('        WARNING: less than 6 dB of contrast. Either the coil is not')\n",
    "    print('        coupled, the drive is too small, or SEARCH_STEP is stepping')\n",
    "    print('        over a narrow line. Halve SEARCH_STEP and try again.')"
