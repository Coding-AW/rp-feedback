   "source": [
    "\n",
    "# =============================================================================\n",
    "#  STEP 8b - HOW THE EFFECT SCALES WITH GAIN, and where the boundary is\n",
    "# =============================================================================\n",
    "#  Define K from the measured quality factor by Q_eff = Q0 / (1 - K). K is then\n",
    "#  the fraction of the coil's loss the feedback is cancelling, it should be\n",
    "#  proportional to the gain, and K = 1 is the self-oscillation boundary.\n",
    "#\n",
    "#  The boundary is EXTRAPOLATED from the linear region, never approached. See\n",
    "#  the note above this step.\n",
    "# =============================================================================\n",
    "print('')\n",
    "print('STEP 8b - K against gain at the narrowing phase')\n",
    "print('-' * 68)\n",
    "\n",
    "#  MEASURE EACH GAIN AT BOTH phi_narrow AND phi_narrow + 180.\n",
    "#\n",
    "#  K = 1 - Q0/Q(phi) needs Q0 - the no-feedback quality factor - measured\n",
    "#  minutes earlier in Step 3, so every drift since then goes straight into K.\n",
    "#  With Q(phi) = Q0/(1 - K) at the narrowing phase and Q0/(1 + K) at the\n",
    "#  opposite one, the pair gives\n",
    "#\n",
    "#      (Q+ - Q-) / (Q+ + Q-)  =  K            exactly, with Q0 cancelled.\n",
    "#\n",
    "#  No reference measurement, no drift term, and twice the signal. At a K of a\n",
    "#  percent that is the difference between a number and a rumour.\n",
    "def _q_at(phi, A):\n",
    "    \"\"\"Quality factor with the loop closed at gain A and phase phi.\"\"\"\n",
    "    ps.set(A, phi)\n",
    "    time.sleep(SETTLE)\n",
    "    gen.freq(F0); gen.amp(DRIVE_FRAC); gen.run(); time.sleep(0.02)\n",
    "    lvl = sc.peak_frac(GUARD_NSAMP)\n",
    "    gen.amp(0.0)\n",
    "    if lvl > FB_LEVEL_GUARD:\n",
    "        raise RuntimeError('input at %.2f of full scale' % lvl)\n",
    "    fq, zq = sweep(grid8, drive_frac=DRIVE_FRAC, navg=FB_NAVG,\n",
    "                   level_guard=FB_LEVEL_GUARD)\n",
    "    return fit_or_raise(fq, np.abs(zq) ** 2, F0, LW,\n",
    "                        what='Step 8b fit at %.0f deg, gain %.2f' % (phi, A))\n",
    "\n",
    "\n",
    "gains_ok, ks = [], []\n",
    "try:\n",
    "    for A in FB_GAINS_USE:\n",
    "        try:\n",
    "            fplus = _q_at(PHI_NARROW, A)\n",
    "            fminus = _q_at(PHI_BROAD, A)\n",
    "            qp, qm = fplus['Q'], fminus['Q']\n",
    "            K = (qp - qm) / (qp + qm)\n",
    "            gains_ok.append(A); ks.append(K)\n",
    "            print('  gain %.2f : Q+ = %7.1f, Q- = %7.1f  ->  K = %.4f  '\n",
    "                  '(centre split %+.0f Hz)'\n",
    "                  % (A, qp, qm, K, fplus['f0'] - fminus['f0']))\n",
    "        except Exception as exc:\n",
    "            print('  gain %.2f : abandoned (%s)' % (A, exc))\n",
    "finally:\n",
    "    # Highest gains in the notebook are applied here. Open the loop\n",
    "    # and kill the drive on every exit path, including Ctrl-C.\n",
    "    ps.off()\n",
    "    gen.off()\n",
    "\n",
    "if len(gains_ok) >= 2:\n",
    "    gains_ok = np.array(gains_ok); ks = np.array(ks)\n",
    "    # forced through the origin: zero gain must mean zero effect\n",
    "    k_slope = float(np.sum(gains_ok * ks) / np.sum(gains_ok ** 2))\n",
    "    A_ONSET = 1.0 / k_slope if k_slope > 0 else float('nan')\n",
    "    pred = k_slope * gains_ok\n",
    "    lin_err = float(np.max(np.abs(ks - pred))) if len(ks) else float('nan')\n",
    "    print('')\n",
    "    print('  K = %.3f x gain   (fit forced through the origin)' % k_slope)\n",
    "    print('  worst departure from proportional : %.3f' % lin_err)\n",
    "    print('  predicted from the budget         : K = %.4f x gain' % G_FWD_RES)\n",
    "    print('  extrapolated self-oscillation onset at gain %.2f' % A_ONSET)\n",
    "    if not FB_DETECTED:\n",
    "        print('')\n",
    "        print('  DO NOT READ THE NUMBERS ABOVE AS PHYSICS. Step 8a found no effect')\n",
    "        print('  above the noise, so this fit is a straight line through scatter.')\n",
    "        print('  K, its slope and the onset gain are all meaningless here.')\n",
    "    elif A_ONSET >= 1.99:\n",
    "        print('')\n",
    "        print('  The onset is beyond the largest coefficient the register can hold')\n",
    "        print('  (1.99), so self-oscillation is UNREACHABLE with this coupling. That')\n",
    "        print('  is the honest result for a passively coupled coil rather than a')\n",
    "        print('  shortcoming of the measurement: the round trip crosses %.1f pF'\n",
    "              % (C_COUPLE * 1e12))\n",
    "        print('  twice and loses about %.0f dB, and no setting recovers it.'\n",
    "              % abs(20 * np.log10(max(G_FWD_RES, 1e-12))))\n",
    "        print('  An amplifier in the pickup path is the change that would.')\n",
    "    elif A_ONSET < max(FB_GAINS_USE) * 1.3:\n",
    "        print('  NOTE: that is close to the gains already used. Do not raise')\n",
    "        print('  FB_GAINS further without watching the input level.')\n",
    "    print('')\n",
    "    print('  NOT MEASURED ON PURPOSE: the boundary itself. On the emulator,')\n",
    "    print('  bisecting into oscillation was safe and informative. Here it')\n",
    "    print('  saturates the input, and a saturated input still looks vaguely like')\n",
    "    print('  a resonance. Make that a separate, deliberate experiment.')\n",
    "else:\n",
    "    A_ONSET = float('nan')\n",
    "    k_slope = float('nan')\n",
    "    print('  too few usable gains to fit K')"
   ]
  },
