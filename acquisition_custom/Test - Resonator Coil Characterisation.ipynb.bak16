   "source": [
    "# =============================================================================\n",
    "#  STEP 4c - HOW MUCH GAIN IS THE AMPLIFIER ACTUALLY GIVING?\n",
    "# =============================================================================\n",
    "#  A ladder of drive levels, climbing until the amplifier is near its rating.\n",
    "#  It never needs to know the amplifier's gain: the level at its OUTPUT follows\n",
    "#  from what arrives at the INPUT and the passive transfer measured without it,\n",
    "#\n",
    "#      amp output [dBm] = 10 + 20 log10( tone / G_PASSIVE )\n",
    "#\n",
    "#  so each rung measures the level it just produced and refuses the next one if\n",
    "#  that would exceed AMP_OUT_MAX_DBM. Safe whatever is in the box.\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 4c - amplifier gain ladder')\n",
    "print('=' * 68)\n",
    "print('passive transfer without the amplifier : %.5f' % G_PASSIVE)\n",
    "print('stopping when the amplifier would pass : %+.1f dBm' % AMP_OUT_MAX_DBM)\n",
    "print('')\n",
    "print('%9s %8s %10s %9s %10s' % ('drive', 'tone', 'G total', 'gain dB', 'amp dBm'))\n",
    "\n",
    "amp_D, amp_G, amp_dbm = [], [], []\n",
    "_why = 'reached the amplifier rating'\n",
    "try:\n",
    "    D = AMP_TEST_START\n",
    "    while D <= DRIVE_MAX:\n",
    "        gen.freq(F0); gen.amp(D); gen.run(); time.sleep(0.05)\n",
    "        tone = sc.tone_frac(F0)\n",
    "        gen.amp(0.0)\n",
    "        if tone <= 0:\n",
    "            _why = 'no signal at the input'; break\n",
    "        Gt = tone / D\n",
    "        out = 10.0 + 20.0 * np.log10(max(tone / G_PASSIVE, 1e-12))\n",
    "        amp_D.append(D); amp_G.append(Gt); amp_dbm.append(out)\n",
    "        print('%9.4f %8.5f %10.4f %+9.1f %+10.1f'\n",
    "              % (D, tone, Gt, 20 * np.log10(Gt / G_PASSIVE), out))\n",
    "        if tone > 0.5:\n",
    "            _why = 'input approaching full scale'; break\n",
    "        if len(amp_G) > 2 and Gt < 0.79 * max(amp_G):\n",
    "            _why = 'gain has fallen 2 dB - the amplifier is compressing'; break\n",
    "        if out + 20.0 * np.log10(AMP_TEST_STEP) > AMP_OUT_MAX_DBM:\n",
    "            break\n",
    "        D *= AMP_TEST_STEP\n",
    "        if D > DRIVE_MAX:\n",
    "            _why = 'DRIVE_MAX reached before the amplifier rating'\n",
    "finally:\n",
    "    gen.off()\n",
    "\n",
    "print('')\n",
    "print('stopped: %s' % _why)\n",
    "if len(amp_G) < 2:\n",
    "    raise RuntimeError('ladder too short to measure a gain - check the wiring')\n",
    "\n",
    "# The linear region: rungs within 10% of the best transfer. Never fewer than\n",
    "# two - a \"gain\" from a single rung is a reading, not a measurement.\n",
    "_lin = [g for g in amp_G if g > 0.90 * max(amp_G)]\n",
    "if len(_lin) < 2:\n",
    "    _lin = sorted(amp_G)[-2:]\n",
    "    print('  (only one rung stayed within 10% - gain is provisional)')\n",
    "G_WITH_AMP = float(np.mean(_lin))\n",
    "AMP_GAIN_DB = float(20 * np.log10(G_WITH_AMP / G_PASSIVE))\n",
    "DRIVE_SUGGEST = float(min(amp_D[int(np.argmax(amp_G))],\n",
    "                          amp_D[-1] * 10 ** ((AMP_OUT_MAX_DBM - 3.0 - amp_dbm[-1]) / 20.0)))\n",
    "\n",
    "print('  amplifier gain          : %+.1f dB  (%.0fx), from %d linear rungs'\n",
    "      % (AMP_GAIN_DB, 10 ** (AMP_GAIN_DB / 20), len(_lin)))\n",
    "print('  round-trip transfer     : %.4f  (was %.4f)' % (G_WITH_AMP, G_PASSIVE))\n",
    "print('  self-oscillation onset  : A = %.2f   (register limit 1.99)'\n",
    "      % (1.0 / G_WITH_AMP))\n",
    "print('  suggested DRIVE_FRAC    : %.4f' % DRIVE_SUGGEST)\n",
    "print('-' * 68)\n",
    "if 1.0 / G_WITH_AMP < 1.99:\n",
    "    print('  REACHABLE - the instability region will appear in the Step 8c map.')\n",
    "else:\n",
    "    print('  NOT reachable: %.0f dB short. A second amplifier in the same path'\n",
    "          % (20 * np.log10((1.0 / 1.99) / G_WITH_AMP)))\n",
    "    print('  would close it; the map will otherwise be complete but with no')\n",
    "    print('  black region.')\n",
    "#  The abort applies only when an amplifier is DECLARED, because that is the\n",
    "#  case where DRIVE_MAX was derived from the declared figure and is therefore\n",
    "#  too permissive. With nothing declared, a measured \"gain\" means G_PASSIVE is\n",
    "#  stale - worth saying, but not a hazard. The protection against an amplifier\n",
    "#  that is fitted but NOT declared is preflight_drive(), which measures the\n",
    "#  actual input level and does not care what anyone declared.\n",
    "if EXT_GAIN_DB <= 0.0 and abs(AMP_GAIN_DB) > 3.0:\n",
    "    print('')\n",
    "    print('  *** %.1f dB of gain measured but EXT_GAIN_DB says none is fitted.'\n",
    "          % AMP_GAIN_DB)\n",
    "    print('  Either G_PASSIVE (%.5f) is stale, or an amplifier is fitted and'\n",
    "          % G_PASSIVE)\n",
    "    print('  undeclared - in which case DRIVE_MAX is far too permissive. Resolve')\n",
    "    print('  this before running any further step.')\n",
    "elif EXT_GAIN_DB > 0.0 and AMP_GAIN_DB > EXT_GAIN_DB + 3.0:\n",
    "    raise RuntimeError(\n",
    "        'EXT_GAIN_DB declares %.1f dB but the ladder measured %.1f dB. DRIVE_MAX '\n",
    "        'was derived from the declared figure, so it is %.1f dB too permissive '\n",
    "        'and every later step would over-drive the amplifier. Put %.1f in the '\n",
    "        'configuration cell and re-run from the top.'\n",
    "        % (EXT_GAIN_DB, AMP_GAIN_DB, AMP_GAIN_DB - EXT_GAIN_DB, AMP_GAIN_DB))\n",
    "elif abs(AMP_GAIN_DB - EXT_GAIN_DB) > 3.0:\n",
    "    print('  NOTE: EXT_GAIN_DB says %.1f dB, measured %.1f. Safe (the ceiling is'\n",
    "          % (EXT_GAIN_DB, AMP_GAIN_DB))\n",
    "    print('  too strict rather than too loose), but update it for a full range.')\n",
    "else:\n",
    "    print('  EXT_GAIN_DB (%.1f dB) agrees with the ladder.' % EXT_GAIN_DB)\n",
    "print('  Set DRIVE_FRAC = %.4f and re-run from Step 3 - every measurement above'\n",
    "      % DRIVE_SUGGEST)\n",
    "print('  was taken at DRIVE_FRAC = %.4f.' % DRIVE_FRAC)\n"
   ]
  },
