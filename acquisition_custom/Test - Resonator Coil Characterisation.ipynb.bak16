    "\n",
    "# =============================================================================\n",
    "#  STEP 8b - HOW THE EFFECT SCALES WITH GAIN, and where the boundary is\n",
    "# =============================================================================\n",
    "#  Define K from the measured quality factor by Q_eff = Q0 / (1 - K). K is then\n",
    "#  the fraction of the coil's loss the feedback is cancelling, it should be\n",
    "#  proportional to the gain, and K = 1 is the self-oscillation boundary.\n",
    "#\n",
    "#  The boundary is EXTRAPOLATED from the linear region, never approached. See\n",
    "#  the note above this step.\n",
    "# =============================================================================\n",
    "print('')\n",
    "print('STEP 8b - K against gain at the narrowing phase')\n",
    "print('-' * 68)\n",
    "\n",
    "#  Measure each gain at BOTH phi_narrow and phi_narrow + 180. With\n",
    "#  Q+ = Q0/(1-K) and Q- = Q0/(1+K),\n",
    "#      (Q+ - Q-) / (Q+ + Q-) = K\n",
    "#  exactly, with Q0 cancelled - no reference measurement, no drift term.\n",
    "def _q_at(phi, A):\n",
    "    \"\"\"Quality factor with the loop closed at gain A and phase phi.\"\"\"\n",
    "    ps.set(A, phi)\n",
    "    time.sleep(SETTLE)\n",
    "    gen.freq(F0); gen.amp(DRIVE_FRAC); gen.run(); time.sleep(0.02)\n",
    "    lvl = sc.peak_frac(GUARD_NSAMP)\n",
    "    gen.amp(0.0)\n",
    "    if lvl > FB_LEVEL_GUARD:\n",
    "        raise RuntimeError('input at %.2f of full scale' % lvl)\n",
    "    fq, zq = sweep(grid8, drive_frac=DRIVE_FRAC, navg=FB_NAVG,\n",
    "                   level_guard=FB_LEVEL_GUARD)\n",
    "    _f = fit_lorentzian(fq, np.abs(zq) ** 2)\n",
    "    if not (0.02 * LW < _f['lw'] < 50.0 * LW):\n",
    "        raise ValueError('width %.1f kHz is nowhere near the %.1f kHz line'\n",
    "                         % (_f['lw'] / 1e3, LW / 1e3))\n",
    "    return _f\n",
    "\n",
    "\n",
    "FB_8B_OK = bool(np.isfinite(PHI_NARROW) and FB_DETECTED)\n",
    "if not FB_8B_OK:\n",
    "    # Skip rather than halt: Step 8c is still worth running, and a Lorentzian\n",
    "    # fitted at a phase that means nothing is worse than no number at all.\n",
    "    k_slope = A_ONSET = k_free = k_int = float('nan')\n",
    "    gains_ok, ks = [], []\n",
    "    print('  SKIPPED - Step 8a found no usable narrowing phase (effect detected'\n",
    "          ' = %s).' % FB_DETECTED)\n",
    "    print('  If the probe gain sat on the oscillation boundary, lower')\n",
    "    print('  FB_GAIN_PROBE; if the loop simply has no gain, this is the answer.')\n",
    "\n",
    "gains_ok, ks = [], []\n",
    "if FB_8B_OK:\n",
    "  try:\n",
    "      for A in FB_GAINS_USE:\n",
    "          try:\n",
    "              fplus = _q_at(PHI_NARROW, A)\n",
    "              fminus = _q_at(PHI_BROAD, A)\n",
    "              qp, qm = fplus['Q'], fminus['Q']\n",
    "              K = (qp - qm) / (qp + qm)\n",
    "              gains_ok.append(A); ks.append(K)\n",
    "              print('  gain %.2f : Q+ = %7.1f, Q- = %7.1f  ->  K = %.4f  '\n",
    "                    '(centre split %+.0f Hz)'\n",
    "                    % (A, qp, qm, K, fplus['f0'] - fminus['f0']))\n",
    "          except Exception as exc:\n",
    "              print('  gain %.2f : abandoned (%s)' % (A, exc))\n",
    "  finally:\n",
    "      # Highest gains in the notebook are applied here. Open the loop\n",
    "      # and kill the drive on every exit path, including Ctrl-C.\n",
    "      ps.off()\n",
    "      gen.off()\n",
    "\n",
    "if len(gains_ok) >= 2:\n",
    "    gains_ok = np.array(gains_ok); ks = np.array(ks)\n",
    "    # forced through the origin: zero gain must mean zero effect\n",
    "    k_slope = float(np.sum(gains_ok * ks) / np.sum(gains_ok ** 2))\n",
    "    # ALSO fit with a free intercept: anything gain-independent otherwise gets\n",
    "    # absorbed into the origin-forced slope and biases the loop gain.\n",
    "    k_free = k_int = float('nan')\n",
    "    if len(gains_ok) >= 3:\n",
    "        k_free, k_int = np.polyfit(gains_ok, ks, 1)\n",
    "        k_free = float(k_free); k_int = float(k_int)\n",
    "    A_ONSET = 1.0 / k_slope if k_slope > 0 else float('nan')\n",
    "    pred = k_slope * gains_ok\n",
    "    lin_err = float(np.max(np.abs(ks - pred))) if len(ks) else float('nan')\n",
    "    print('')\n",
    "    print('  K = %.4f x gain          (forced through the origin)' % k_slope)\n",
    "    if np.isfinite(k_free):\n",
    "        print('  K = %.4f + %.4f x gain  (free intercept)' % (k_int, k_free))\n",
    "        if abs(k_int) > 0.25 * float(np.max(np.abs(ks))):\n",
    "            print('  *** THE INTERCEPT IS NOT NEGLIGIBLE: %.0f%% of the largest K'\n",
    "                  % (100 * abs(k_int) / float(np.max(np.abs(ks)))))\n",
    "            print('  measured. K must be zero at zero gain, so something')\n",
    "            print('  gain-independent is leaking into it - drift between the two')\n",
    "            print('  phases, or an error in the phase axis making the pair')\n",
    "            print('  cancel imperfectly. TAKE THE FREE-FIT SLOPE as the loop gain')\n",
    "            print('  and add more gain points before quoting either.')\n",
    "    print('  worst departure from proportional : %.3f' % lin_err)\n",
    "    print('  predicted from the budget         : K = %.4f x gain' % G_FWD_RES)\n",
    "    print('  extrapolated self-oscillation onset at gain %.2f' % A_ONSET)\n",
    "    if not FB_DETECTED:\n",
    "        print('')\n",
    "        print('  DO NOT READ THE NUMBERS ABOVE AS PHYSICS. Step 8a found no effect')\n",
    "        print('  above the noise, so this fit is a straight line through scatter.')\n",
    "        print('  K, its slope and the onset gain are all meaningless here.')\n",
    "    elif A_ONSET >= 1.99:\n",
    "        print('')\n",
    "        print('  The onset is beyond the largest coefficient the register can hold')\n",
    "        print('  (1.99), so self-oscillation is UNREACHABLE with this coupling. That')\n",
    "        print('  is the honest result for a passively coupled coil rather than a')\n",
    "        print('  shortcoming of the measurement: the round trip crosses %.1f pF'\n",
    "              % (C_COUPLE * 1e12))\n",
    "        print('  twice and loses about %.0f dB, and no setting recovers it.'\n",
    "              % abs(20 * np.log10(max(G_FWD_RES, 1e-12))))\n",
    "        print('  An amplifier in the pickup path is the change that would.')\n",
    "    elif A_ONSET < max(FB_GAINS_USE) * 1.3:\n",
    "        print('  NOTE: that is close to the gains already used. Do not raise')\n",
    "        print('  FB_GAIN_FRACS further without watching the input level.')\n",
    "    print('')\n",
    "    print('  NOT MEASURED ON PURPOSE: the boundary itself. On the emulator,')\n",
    "    print('  bisecting into oscillation was safe and informative. Here it')\n",
    "    print('  saturates the input, and a saturated input still looks vaguely like')\n",
    "    print('  a resonance. Make that a separate, deliberate experiment.')\n",
    "else:\n",
    "    A_ONSET = float('nan')\n",
    "    k_slope = float('nan')\n",
    "    print('  too few usable gains to fit K')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "# Step 8c — The gain/phase map\n",
    "\n",
    "This is the measurement Herkenhoff *et al.* present as their resonator modification scan: the\n",
    "quality factor and the detuning of the resonance, each mapped over a plane of feedback **gain**\n",
    "against feedback **phase**, with the self-oscillation region left blank, and 1D cuts beneath.\n",
    "\n",
    "Their map is 128×128 pixels. Each pixel here costs a small frequency sweep and a fit, so the\n",
    "default is 24×12 — visually the same object, a few minutes rather than a few days. Raise\n",
    "`FB_MAP_PHASES` and `FB_MAP_GAINS` if you want it finer and have the time.\n",
    "\n",
    "**The grid tracks the line.** Feedback narrows the resonance by 1/(1−K) and shifts it, so a\n",
    "frequency span chosen for the unfed line ends up with barely one point across a line that\n",
    "feedback has narrowed five-fold. Each pixel therefore sweeps around the *previous* pixel's\n",
    "fitted centre and width, resetting to the Step 3 values whenever a fit fails.\n",
    "\n",
    "**Self-oscillation is detected, not approached.** Before each pixel is measured the drive is\n",
    "switched off and the input level read. A loop that has gone unstable produces a large signal\n",
    "with no drive at all, which is unmistakable. Those pixels are recorded as blank and drawn\n",
    "black, exactly as the paper does — and the feedback is opened immediately rather than left\n",
    "running.\n",
    "\n",
    "Whether any black appears depends on whether the loop can reach K = 1 at all. The onset gain is\n",
    "1/G; with the register limited to 1.99, self-oscillation is reachable only once the round-trip\n",
    "transfer exceeds about 0.5. Step 8's budget prints where you stand.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "#  STEP 8c - GAIN / PHASE MAP  (Herkenhoff et al., resonator modification scan)\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 8c - mapping Q and detuning over gain and phase')\n",
    "print('=' * 68)\n",
    "\n",
    "map_phi = np.linspace(0.0, 360.0, FB_MAP_PHASES, endpoint=False)\n",
    "#  The gain axis deliberately goes PAST the boundary, because the black region\n",
    "#  is the point of the figure. FB_GAIN_CEIL stops just short of K = 1 by\n",
    "#  construction (the closed-loop signal diverges there), so the map uses its own\n",
    "#  ceiling with the oscillation check as the safety net.\n",
    "#\n",
    "#  UNLESS an external amplifier makes that unsafe. An oscillating loop drives the\n",
    "#  DAC to full scale, and DRIVE_MAX does not bound the feedback path, so the\n",
    "#  amplifier would see 10 - EXT_PAD_DB dBm.\n",
    "_osc_gain = 1.6 / max(G_FWD_RES, 1e-9)\n",
    "MAP_CAN_OSCILLATE = True\n",
    "if EXT_GAIN_DB > 0.0 and (10.0 - EXT_PAD_DB) > AMP_IN_MAX_DBM:\n",
    "    MAP_CAN_OSCILLATE = False\n",
    "    _osc_gain = FB_GAIN_CEIL\n",
    "    print('NOT exploring past the oscillation boundary: an oscillating loop would')\n",
    "    print('put %+.1f dBm into the amplifier against a %+.1f dBm rating. Fit at'\n",
    "          % (10.0 - EXT_PAD_DB, AMP_IN_MAX_DBM))\n",
    "    print('least %.0f dB of pad between OUT1 and the amplifier to allow it.'\n",
    "          % (10.0 - AMP_IN_MAX_DBM))\n",
    "    print('')\n",
    "#  LOG-spaced gains: the thesis plots |G| in dB, so the samples must be even in\n",
    "#  dB, not in amplitude. Spans 40 dB below the ceiling.\n",
    "_gmax = float(min(FB_GAIN_MAX, _osc_gain))\n",
    "map_gain = _gmax * np.logspace(-2.0, 0.0, FB_MAP_GAINS)\n",
    "map_gain_db = 20.0 * np.log10(map_gain)\n",
    "MAP_Q = np.full((FB_MAP_GAINS, FB_MAP_PHASES), np.nan)\n",
    "MAP_DF = np.full((FB_MAP_GAINS, FB_MAP_PHASES), np.nan)\n",
    "MAP_OSC = np.zeros((FB_MAP_GAINS, FB_MAP_PHASES), dtype=bool)\n",
    "\n",
    "# settle + the averaged reads + the per-point level guard, which is the\n",
    "# biggest single term at GUARD_NSAMP single-word reads per frequency.\n",
    "_per = FB_MAP_NPTS * (FB_MAP_SETTLE + (2 * FB_MAP_NAVG + GUARD_NSAMP) * 1.0e-5) + 0.05\n",
    "print('grid %d phases x %d gains = %d pixels, roughly %.0f s'\n",
    "      % (FB_MAP_PHASES, FB_MAP_GAINS, FB_MAP_PHASES * FB_MAP_GAINS,\n",
    "         FB_MAP_PHASES * FB_MAP_GAINS * _per))\n",
    "print('gain axis %.3f to %.2f  (%.0f to %+.0f dB), K up to %.3f'\n",
    "      % (map_gain[0], map_gain[-1], map_gain_db[0], map_gain_db[-1],\n",
    "         map_gain[-1] * G_FWD_RES))\n",
    "print('')\n",
    "\n",
    "acq.start(DEC_USE)\n",
    "ps.config_delay(F0)\n",
    "_t0 = time.time()\n",
    "try:\n",
    "    for gi, A in enumerate(map_gain):\n",
    "        f0_t, lw_t = F0, LW                      # tracker, reset each row\n",
    "        for pj, phi in enumerate(map_phi):\n",
    "            ps.set(A, phi)\n",
    "            time.sleep(SETTLE)\n",
    "\n",
    "            # --- is the loop oscillating? drive OFF, look for signal anyway ---\n",
    "            gen.amp(0.0)\n",
    "            time.sleep(0.005)\n",
    "            if sc.peak_frac(GUARD_NSAMP) > FB_OSC_LEVEL:\n",
    "                ps.off()                         # open the loop immediately\n",
    "                MAP_OSC[gi, pj] = True\n",
    "                f0_t, lw_t = F0, LW\n",
    "                continue\n",
    "\n",
    "            try:\n",
    "                span = 2.5 * max(lw_t, 0.15 * LW)\n",
    "                grid = f0_t + np.linspace(-span, span, FB_MAP_NPTS)\n",
    "                fm, zm = sweep(grid, drive_frac=DRIVE_FRAC, navg=FB_MAP_NAVG,\n",
    "                               settle=FB_MAP_SETTLE, level_guard=FB_LEVEL_GUARD)\n",
    "                fit = fit_lorentzian(fm, np.abs(zm) ** 2)\n",
    "                if not (0.05 * LW < fit['lw'] < 20.0 * LW):\n",
    "                    raise ValueError('width out of range')\n",
    "                MAP_Q[gi, pj] = fit['Q']\n",
    "                MAP_DF[gi, pj] = fit['f0'] - F0\n",
    "                f0_t, lw_t = fit['f0'], fit['lw']        # track for the next pixel\n",
    "            except Exception:\n",
    "                f0_t, lw_t = F0, LW                      # lost it - start over\n",
    "        print('  gain %5.3f  (K = %.3f) : %2d fitted, %2d oscillating'\n",
    "              % (A, A * G_FWD_RES, int(np.sum(np.isfinite(MAP_Q[gi]))),\n",
    "                 int(np.sum(MAP_OSC[gi]))))\n",
    "finally:\n",
    "    ps.off()\n",
    "    gen.off()\n",
    "\n",
    "print('')\n",
    "print('map complete in %.0f s' % (time.time() - _t0))\n",
    "print('  Q range      : %.1f to %.1f  (no feedback: %.1f)'\n",
    "      % (np.nanmin(MAP_Q), np.nanmax(MAP_Q), Q_SWEEP))\n",
    "print('  detuning     : %+.2f to %+.2f kHz'\n",
    "      % (np.nanmin(MAP_DF) / 1e3, np.nanmax(MAP_DF) / 1e3))\n",
    "print('  oscillating  : %d of %d pixels'\n",
    "      % (int(np.sum(MAP_OSC)), MAP_OSC.size))\n",
    "if not np.any(MAP_OSC):\n",
    "    if not MAP_CAN_OSCILLATE:\n",
    "        print('  -> the gain axis was capped short of the boundary on purpose.')\n",
    "    else:\n",
    "        print('  -> no instability region: K = 1 needs a transfer above %.2f and'\n",
    "              % (1.0 / max(FB_GAIN_MAX, 1e-9)))\n",
    "        print('     you have %.3f.' % G_FWD_RES)\n"
   ]
