   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n#  INTERNAL SCOPE - base 0x40100000\n# =============================================================================\n#  16384 raw samples at up to 125 MSa/s. The only overload guard on the real\n#  path: the emulator's sticky clip flag is gone once a real coil is measured.\n#  Sees the same signal as the rest of the chain, so with the emulator enabled it\n#  shows the emulator.\n# =============================================================================\n",
    "SC_BASE = 0x40100000\n",
    "SC_SPAN = 0x40000\n",
    "SC_BUF_A = 0x10000\n",
    "SC_BUF_B = 0x20000\n",
    "SC_NMAX = 1 << 14\n",
    "\n",
    "\n",
    "class Scope(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, SC_BASE, span=SC_SPAN)\n",
    "\n",
    "    def _buf(self, off, n):\n",
    "        \"\"\"Read n samples, one 32-bit word at a time (this is a register block,\n",
    "        not DDR). The buffer holds 14-bit two's-complement values.\"\"\"\n",
    "        ba = bytearray(4 * n)\n",
    "        m = self.m\n",
    "        for i in range(n):\n",
    "            o = off + 4 * i\n",
    "            ba[4 * i:4 * i + 4] = m[o:o + 4]\n",
    "        v = np.frombuffer(bytes(ba), dtype='<u4').astype(np.int64) & 0x3FFF\n",
    "        return np.where(v & 0x2000, v - 0x4000, v).astype(float)\n",
    "\n",
    "    def acquire(self, dec=1, n=SC_NMAX, chan='A'):\n",
    "        \"\"\"Capture and return (samples, sample_rate). dec = 1 is every sample.\"\"\"\n",
    "        self.w(0x14, dec)\n",
    "        self.w(0x10, n - 1)\n",
    "        self.w(0x00, 2)        # reset the capture engine\n",
    "        self.w(0x00, 1)        # arm\n",
    "        self.w(0x04, 1)        # trigger now, from software\n",
    "        t0 = time.time()\n",
    "        while self.r(0x04) != 0:\n",
    "            if time.time() - t0 > 1.0:\n",
    "                break\n",
    "        time.sleep(0.005)\n",
    "        off = SC_BUF_A if chan == 'A' else SC_BUF_B\n",
    "        return self._buf(off, n), FS_CLK / float(dec)\n",
    "\n",
    "    def peak_frac(self, n=4096):\n",
    "        \"\"\"TOTAL peak excursion as a fraction of full scale. 1.0 means clipping.\n",
    "\n",
    "        Deliberately includes everything - the converter's DC offset, broadband\n",
    "        noise, out-of-band pickup - because all of it counts towards clipping.\n",
    "        That makes it the right guard and the WRONG way to measure the size of a\n",
    "        tone. Use tone_frac() for that.\"\"\"\n",
    "        x, _ = self.acquire(dec=1, n=n)\n",
    "        return float(np.max(np.abs(x))) / 8191.0\n",
    "\n",
    "    def tone_frac(self, f, n=4096):\n",
    "        \"\"\"Amplitude of the component at f alone, as a fraction of full scale.\n",
    "\n",
    "        WHY THIS EXISTS. peak_frac() answers \"how close am I to clipping\". It was\n",
    "        also being used to answer \"how much 40 MHz is arriving\", and those are\n",
    "        not the same question. max|x| is inflated by the converter's DC offset\n",
    "        and by every other thing in the record, so on this board it read about\n",
    "        four times the true tone amplitude - which then over-predicted the\n",
    "        feedback loop gain by the same factor.\n",
    "\n",
    "        A least-squares projection onto cos and sin at the known frequency fixes\n",
    "        it: the mean is removed first, so DC cannot contribute, and anything not\n",
    "        at f is orthogonal to both basis vectors and averages away. No window and\n",
    "        no scalloping loss, because f is known exactly rather than searched.\"\"\"\n",
    "        x, fs = self.acquire(dec=1, n=n)\n",
    "        x = x - np.mean(x)                       # the converter's DC offset\n",
    "        t = np.arange(len(x)) / fs\n",
    "        basis = np.column_stack([np.cos(2.0 * np.pi * f * t),\n",
    "                                 np.sin(2.0 * np.pi * f * t)])\n",
    "        coef, _, _, _ = np.linalg.lstsq(basis, x, rcond=-1)\n",
    "        return float(np.hypot(coef[0], coef[1])) / 8191.0\n",
    "\n",
    "\n",
    "sc = Scope()\n",
    "print('scope mapped, %d samples per capture' % SC_NMAX)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "#  ALL_OFF  -  the one call that makes the hardware harmless\n",
    "# =============================================================================\n",
    "#  Every step below that raises the drive does so inside a try/finally that ends\n",
    "#  here, so an exception, a failed fit or an interrupted cell cannot leave the\n",
    "#  coil being driven with the feedback loop closed. It is also registered to run\n",
    "#  when the kernel shuts down.\n",
    "#\n",
    "#  Safe to call at any time, including twice, including when nothing is running.\n",
    "#  If anything ever looks wrong on the bench, run all_off() in a fresh cell.\n",
    "# =============================================================================\n",
    "def all_off():\n",
    "    \"\"\"Silence the drive, open the feedback loop, disable the emulator.\"\"\"\n",
    "    for what, fn in (('generator', lambda: gen.off()),\n",
    "                     ('feedback', lambda: ps.off()),\n",
    "                     ('emulator', lambda: emu.disable())):\n",
    "        try:\n",
    "            fn()\n",
    "        except Exception as exc:\n",
    "            # One block failing to switch off must never stop the others being\n",
    "            # switched off - the generator is the one that matters.\n",
    "            print('all_off: could not switch off the %s (%s)' % (what, exc))\n",
    "\n",
    "\n",
    "import atexit\n",
    "atexit.register(all_off)\n",
    "all_off()\n",
    "print('all_off() defined and armed - drive, feedback and emulator are all off')"
   ]
  },
