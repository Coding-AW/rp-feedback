    "    'coil': {\n",
    "        'f0_hz': float(F0),\n",
    "        'linewidth_hz': float(LW),\n",
    "        'q_swept': float(Q_SWEEP),\n",
    "        'q_alt_dec': (float(_qa) if _qa else None),\n",
    "        'q_vna': (float(VNA_Q) if VNA_Q else None),\n",
    "        'f0_vna_hz': (float(VNA_F0) if VNA_F0 else None),\n",
    "        'floor_frac_fit': float(FLOOR_FRAC),\n",
    "        'floor_frac_direct': float(FLOOR_DIRECT / max(np.sqrt(FIT['peak'] + FIT['base']), 1e-300)),\n",
    "    },\n",
    "    'lc_crosscheck': {\n",
    "        'l_coil_h': L_COIL, 'l_coil_err_h': L_COIL_ERR,\n",
