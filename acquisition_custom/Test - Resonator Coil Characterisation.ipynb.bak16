    "        'c_unaccounted_f': float(C_UNACCOUNTED),\n",
    "        'f0_predicted_hz': float(F0_PRED),\n",
    "        'f0_predicted_err_hz': float(F0_PRED_ERR),\n",
    "        'f0_deviation_sigma': float(abs(F0 - F0_PRED) / F0_PRED_ERR),\n",
    "        'f0_bare_coil_hz': float(F0_BARE),\n",
    "        'z0_tank_ohm': float(Z0_TANK),\n",
    "        'r_series_ohm': float(R_SERIES),\n",
    "        'r_parallel_ohm': float(R_PARALLEL),\n",
    "        'q_bare_coil_implied': float(Q_BARE_IMPLIED),\n",
    "        'g_fwd_measured': float(G_FWD),\n",
    "        'g_fwd_predicted': float(G_FWD_PRED),\n",
    "    },\n",
    "    'coupling': {\n",
    "        'c_couple_f': C_COUPLE,\n",
    "        'c_stray_est_f': C_STRAY_EST,\n",
    "        'predicted_divider': float(C_COUPLE / (C_COUPLE + C_STRAY_EST)),\n",
    "        'xc_ohm_at_f0': float(1.0 / (2 * np.pi * F0 * C_COUPLE)),\n",
    "    },\n",
    "    'drive': {\n",
    "        'frac': DRIVE_FRAC,\n",
    "        'linear': bool(globals().get('LINEAR_OK', False)),\n",
    "    },\n",
    "    'receiver': {\n",
    "        'dec_log2': int(DEC_USE),\n",
    "        'output_rate_hz': float(FS_CLK / (1 << DEC_USE)),\n",
    "        'clean_halfwidth_hz': float(0.10 * FS_CLK / (1 << DEC_USE)),\n",
    "        'n_avg': N_AVG,\n",
    "    },\n",
    "    'stability': {\n",
    "        'drift_hz_per_min': float(_g('DRIFT_HZ_PER_MIN', float('nan'))),\n",
    "        'scatter_hz': float(_g('SCATTER_HZ', float('nan'))),\n",
    "    },\n",
    "    'feedback': {\n",
    "        'phi_narrow_deg': float(_g('PHI_NARROW', float('nan'))),\n",
