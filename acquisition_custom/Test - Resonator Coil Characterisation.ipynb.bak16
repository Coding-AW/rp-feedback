   "source": [
    "# --- Step 8c picture: the resonator modification scan ------------------------\n",
    "#  Laid out as Herkenhoff's thesis does it: phase on -180..+180, gain in dB,\n",
    "#  the quality factor on a LOGARITHMIC colour scale, the detuning on a symmetric\n",
    "#  one, and the unstable region left black.\n",
    "_rel = ((map_phi - PHI_NARROW + 180.0) % 360.0) - 180.0\n",
    "_o = np.argsort(_rel)\n",
    "_Q = np.ma.masked_invalid(MAP_Q[:, _o])\n",
    "_D = np.ma.masked_invalid(MAP_DF[:, _o] / 1e3)\n",
    "_cq = plt.get_cmap('jet');   _cq.set_bad('black')\n",
    "_cd = plt.get_cmap('RdBu_r'); _cd.set_bad('black')\n",
    "_ext = [_rel[_o][0], _rel[_o][-1], map_gain_db[0], map_gain_db[-1]]\n",
    "_dlim = float(np.nanmax(np.abs(MAP_DF / 1e3))) or 1.0\n",
    "\n",
    "# cuts: one across phase at high gain, one across gain at the narrowing phase\n",
    "_cg = int(np.argmin(np.abs(map_gain - 0.8 * map_gain[-1])))\n",
    "_cp = int(np.argmin(np.abs(_rel[_o])))\n",
    "\n",
    "fig = plt.figure(figsize=(9.6, 7.4))\n",
    "for k, (dat, cmap, ttl, lab, norm) in enumerate([\n",
    "        (_Q, _cq, '(a)  quality factor', 'Q',\n",
    "         matplotlib.colors.LogNorm(vmin=max(np.nanmin(MAP_Q), 1.0),\n",
    "                                   vmax=np.nanmax(MAP_Q))),\n",
    "        (_D, _cd, '(b)  detuning of the resonance', 'nu_res shift / kHz',\n",
    "         matplotlib.colors.Normalize(vmin=-_dlim, vmax=_dlim))]):\n",
    "    ax = fig.add_subplot(2, 2, k + 1)\n",
    "    ax.grid(False)\n",
    "    im = ax.imshow(dat, origin='lower', aspect='auto', extent=_ext,\n",
    "                   cmap=cmap, norm=norm, interpolation='nearest')\n",
    "    ax.axhline(map_gain_db[_cg], ls='--', lw=1.0, color='w')\n",
    "    ax.axvline(_rel[_o][_cp], ls='--', lw=1.0, color='w')\n",
    "    ax.set_xticks([-180, -90, 0, 90, 180])\n",
    "    ax.set_xlabel('feedback phase rel. to narrowing / degrees')\n",
    "    ax.set_ylabel('feedback gain |A| / dB')\n",
    "    ax.set_title(ttl)\n",
    "    fig.colorbar(im, ax=ax).set_label(lab)\n",
    "\n",
    "    ax2 = fig.add_subplot(2, 2, k + 3)\n",
    "    ax2.plot(_rel[_o], dat[_cg, :], 'o-', color=CLR_BLUE,\n",
    "             label='across phase, %+.0f dB' % map_gain_db[_cg])\n",
    "    ax2.set_xticks([-180, -90, 0, 90, 180])\n",
    "    ax2.set_xlabel('feedback phase rel. to narrowing / degrees')\n",
    "    ax2.set_ylabel(lab)\n",
    "    if k == 0:\n",
    "        ax2.set_yscale('log')\n",
    "        ax2.axhline(Q_SWEEP, ls=':', color=CLR_GREY, label='no feedback')\n",
    "    else:\n",
    "        ax2.axhline(0.0, ls=':', color=CLR_GREY)\n",
    "    ax3 = ax2.twiny()\n",
    "    ax3.plot(map_gain_db, dat[:, _cp], 's-', color=CLR_ORANGE,\n",
    "             label='across gain, at the narrowing phase')\n",
    "    ax3.set_xlabel('feedback gain |A| / dB')\n",
    "    ax3.grid(False)\n",
    "    _h1, _l1 = ax2.get_legend_handles_labels()\n",
    "    _h2, _l2 = ax3.get_legend_handles_labels()\n",
    "    ax2.legend(_h1 + _h2, _l1 + _l2, loc='best')\n",
    "plt.show()\n",
    "\n",
    "print('THE TWO PANELS BENEATH ARE CUTS THROUGH THE MAPS, along the dashed lines.')\n",
    "print('  blue  - across PHASE at fixed gain: Q should peak at 0 (the narrowing')\n",
    "print('          phase) and dip a half turn away; the detuning should cross zero')\n",
    "print('          where Q peaks and be extreme a QUARTER turn from it.')\n",
    "print('  amber - across GAIN at the narrowing phase: Q should rise as Q0/(1-K)')\n",
    "print('          with K proportional to gain, so it runs away towards the')\n",
    "print('          boundary; the detuning stays near zero, because at the')\n",
    "print('          narrowing phase feedback changes damping and not frequency.')\n",
    "print('Measured: Q %.0f -> %.0f (x%.1f), detuning %+.0f to %+.0f kHz.'\n",
    "      % (Q_SWEEP, np.nanmax(MAP_Q), np.nanmax(MAP_Q) / Q_SWEEP,\n",
    "         np.nanmin(MAP_DF) / 1e3, np.nanmax(MAP_DF) / 1e3))\n"
   ]
