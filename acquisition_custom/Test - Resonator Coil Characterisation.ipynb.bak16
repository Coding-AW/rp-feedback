   "source": [
    "\n",
    "---\n",
    "# The four hardware blocks\n",
    "\n",
    "Four register blocks are used. Their full maps live in `acquisition_custom/README.md` and in\n",
    "the header of each Verilog file; only what this notebook needs is repeated here.\n",
    "\n",
    "| Block | Base | Role here |\n",
    "|---|---|---|\n",
    "| **Acquisition** | `0x40600000` | The receiver. Used two ways: as a narrowband voltmeter (registers) and as a recorder (memory) |\n",
    "| **Generator** | `0x40200000` | The stimulus. A stored sine replayed at a chosen rate |\n",
    "| **Phase shifter** | `0x40300000` | The feedback controller, used only in Step 8 |\n",
    "| **Digital resonator** | `0x40400000` | The emulator. Used **only** in Step 1, as a known answer, then switched off |\n",
    "| **Scope** | `0x40100000` | Full-rate capture of the raw input. Needed for level checks |\n",
    "\n",
    "## The trick that makes every sweep simple\n",
    "\n",
    "Tune the receiver's local oscillator to **exactly** the drive frequency. The signal then lands\n",
    "at 0 Hz, where the in-phase and quadrature values are steady numbers that can be read from two\n",
    "registers at leisure. At any other offset they rotate, and two register reads land on different\n",
    "samples — an artefact that once convincingly imitated filter droop in this project.\n",
    "\n",
    "\"Exactly\" is doable rather than approximate, and this notebook is stricter about it than\n",
    "earlier stages were. The generator's frequency word has 30 bits; the local oscillator's has\n",
    "32. Both count the *same* 125 MHz clock. So if the generator's word is `step`, the generator\n",
    "is at exactly `step x 125e6 / 2**30`, and setting the local oscillator word to exactly\n",
    "`4 x step` puts it at precisely the same frequency — not to within a rounding error, but\n",
    "identically. `Generator.freq_word()` and `Acq.tune_word()` below make that pairing explicit."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n#  ACQUISITION SYSTEM - base 0x40600000\n# =============================================================================\n#  VOLTMETER: tune the local oscillator to the drive, read PEEK_I/PEEK_Q.\n#  RECORDER : stream to memory for spectra.\n#  ORDER MATTERS: disable -> write settings -> reset -> enable. The decimator\n#  holds a running total that assumes a fixed R. Retuning the oscillator is one\n#  register write and is safe at any time.\n# =============================================================================\n",
    "class Acq(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40600000)\n",
    "        self.dec = None\n",
    "\n",
    "    # ---- setup ----\n",
    "    def start(self, dec_log2, src=0):\n",
    "        \"\"\"Bring the chain up at a given decimation. Safe to call repeatedly.\"\"\"\n",
    "        self.w(0x00, 0)                 # disable while settings change\n",
    "        self.w(0x08, dec_log2)          # decimation R = 2**dec_log2\n",
    "        self.w(0x0C, src)               # 0 = IN1, 1 = IN2\n",
    "        self.w(0x00, 1 | 2)             # enable + soft reset (self-clearing)\n",
    "        self.w(0x00, 1)                 # running\n",
    "        self.dec = dec_log2\n",
    "\n",
    "    def stop(self):\n",
    "        self.w(0x00, 0)\n",
    "\n",
    "    # ---- tuning ----\n",
    "    def tune_word(self, finc):\n",
    "        \"\"\"Set the local oscillator by its raw 32-bit frequency word.\"\"\"\n",
    "        self.w(0x04, int(finc) & 0xFFFFFFFF)\n",
    "\n",
    "    def tune(self, f):\n",
    "        \"\"\"Set the local oscillator to the nearest word to f hertz.\"\"\"\n",
    "        self.tune_word(int(round(f / FS_CLK * (1 << 32))))\n",
    "\n",
    "    # ---- voltmeter ----\n",
    "    def measure(self, navg=None):\n",
    "        \"\"\"Average navg in-phase/quadrature pairs; return one complex number.\n",
    "\n",
    "        At DC both are steady, so this is coherent averaging: a real signal adds\n",
    "        linearly while noise averages down as the square root of navg.\"\"\"\n",
    "        navg = N_AVG if navg is None else navg\n",
    "        zi = 0.0\n",
    "        zq = 0.0\n",
    "        for _ in range(navg):\n",
    "            zi += self.rs(0x18)\n",
    "            zq += self.rs(0x1C)\n",
    "        return complex(zi / navg, zq / navg)\n",
    "\n",
    "    # ---- housekeeping ----\n",
    "    def f_out(self):\n",
    "        \"\"\"Output sample rate at the current decimation [Hz].\"\"\"\n",
    "        return FS_CLK / (1 << self.dec)\n",
    "\n",
    "    def window_hz(self):\n",
    "        \"\"\"Half-width of the CLEAN part of the receiver window [Hz].\n",
    "\n",
    "        The decimator rejects by better than 75 dB only over the middle fifth of\n",
    "        its output band, so the usable half-width is 0.1 x the output rate.\"\"\"\n",
    "        return 0.10 * self.f_out()\n",
    "\n",
    "    def build_id(self):\n",
    "        return self.r(0x48)\n",
    "\n",
    "    def status2(self):\n",
    "        return self.r(0x38)\n",
    "\n",
    "\n",
    "acq = Acq()\n",
    "print('acquisition mapped. BUILD_ID = 0x%08X' % acq.build_id())"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n#  SIGNAL GENERATOR - base 0x40200000, stock Red Pitaya module\n# =============================================================================\n#  Replays a 16384-entry table; frequency is one register write.\n#      f = step x 125e6 / 2**30      (about 0.116 Hz per step)\n#  Registers: 0x04 amplitude (0x2000 = x1.0), 0x08 table size, 0x0C start,\n#  0x10 step, table at 0x10000. Control 0x00: 0x11 free-run, 0xC0 held at zero.\n# =============================================================================\n",
    "class Generator(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40200000, span=0x20000)\n",
    "        self._step = None\n",
    "\n",
    "    def load_sine(self):\n",
    "        \"\"\"Write one cycle of a sine into the table. Takes a second or two:\n",
    "        16384 single-word writes, and single-word is not negotiable here.\"\"\"\n",
    "        for i in range(16384):\n",
    "            v = int(round(8191.0 * np.sin(2.0 * np.pi * i / 16384.0)))\n",
    "            self.w(0x10000 + 4 * i, v & 0x3FFF)\n",
    "        self.w(0x08, (16384 << 16) - 1)     # table size, fixed point, inclusive\n",
    "        self.w(0x0C, 0)                     # start replaying from entry 0\n",
    "\n",
    "    def freq_word(self, f):\n",
    "        \"\"\"Nearest 30-bit frequency word to f hertz.\"\"\"\n",
    "        return int(round(f / FS_CLK * (1 << 30)))\n",
    "\n",
    "    def set_word(self, step):\n",
    "        \"\"\"Set frequency by raw word; return the frequency actually produced.\"\"\"\n",
    "        self._step = int(step)\n",
    "        self.w(0x10, self._step)\n",
    "        return self._step * FS_CLK / float(1 << 30)\n",
    "\n",
    "    def freq(self, f):\n",
    "        \"\"\"Set frequency in hertz; return the frequency actually produced.\"\"\"\n",
    "        return self.set_word(self.freq_word(f))\n",
    "\n",
    "    def lo_word(self):\n",
    "        \"\"\"The 32-bit local-oscillator word that lands this signal EXACTLY at\n",
    "        0 Hz. The generator counts in units of 2**-30 of the clock and the local\n",
    "        oscillator in units of 2**-32, so the conversion is a factor of four and\n",
    "        carries no rounding error at all.\"\"\"\n",
    "        return 4 * self._step\n",
    "\n",
    "    def amp(self, frac):\n",
    "        \"\"\"Output amplitude as a fraction of full scale. CLAMPED, deliberately.\n",
    "\n",
    "        The register is Q1.13 with 0x2000 = x1.0, and it happily accepts up to\n",
    "        0x3FFF = x1.9999. The write below is masked with & 0x3FFF, so before this\n",
    "        guard existed the mask turned mistakes into silent, WRONG drive levels:\n",
    "\n",
    "            frac = -0.5  ->  0x3000  ->  x1.5   (a sign slip drives 50% HARDER)\n",
    "            frac =  2.0  ->  0x0000  ->  x0.0   (silence, and no complaint)\n",
    "            frac =  1.5  ->  0x3000  ->  x1.5   (clipped square wave, not a sine)\n",
    "\n",
    "        Every one of those is silent on the bench. Anything outside\n",
    "        [0, DRIVE_MAX] is now refused instead, so the only way to drive the coil\n",
    "        harder is to raise DRIVE_MAX in the configuration cell on purpose.\"\"\"\n",
    "        frac = float(frac)\n",
    "        if not np.isfinite(frac):\n",
    "            raise ValueError('drive amplitude is not a finite number: %r' % frac)\n",
    "        if frac < 0.0:\n",
    "            raise ValueError(\n",
    "                'negative drive amplitude (%.4f). A sign has no meaning here, and '\n",
    "                'the register would silently wrap it to x%.4f.'\n",
    "                % (frac, (int(round(frac * 8192)) & 0x3FFF) / 8192.0))\n",
    "        if frac > DRIVE_MAX:\n",
    "            raise ValueError(\n",
    "                'drive %.4f exceeds DRIVE_MAX = %.4f. Nothing in this notebook '\n",
    "                'may drive harder than the ceiling; raise it in the configuration '\n",
    "                'cell if that is really what you want.' % (frac, DRIVE_MAX))\n",
    "        self.w(0x04, int(round(frac * 8192)) & 0x3FFF)\n",
    "\n",
    "    def run(self):\n",
    "        self.w(0x00, 0x40)      # reset the read pointer\n",
    "        self.w(0x00, 0x11)      # free-run, wrap at the end of the table\n",
    "\n",
    "    def off(self):\n",
    "        self.amp(0.0)\n",
    "        self.w(0x00, 0xC0)      # held in reset, output forced to zero\n",
    "\n",
    "\n",
    "gen = Generator()\n",
    "gen.off()\n",
    "gen.load_sine()\n",
    "print('generator ready, table loaded, output off')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n#  PHASE SHIFTER - base 0x40300000   (Step 8 only)\n# =============================================================================\n#  Output = A cos(phi) x I + A sin(phi) x Q, Q being the input delayed a quarter\n#  period. Two corrections, both from the module header:\n#   1. The quarter-period delay is under one clock at 40 MHz, so add whole signal\n#      periods and pick the k whose fraction sits nearest 0 or 1.\n#   2. Fixed THREE-sample latency (L = 3 since FIX 6; one sample is 115 deg at\n#      40 MHz, so a stale value rotates the whole axis). Subtracted from the\n#      request so the delivered phase is the requested one.\n#  Both describe the DIGITAL path only. Step 8 finds its phases by measurement.\n#  \"Feedback off\" is coefficients (0, 0), NOT the bypass bit.\n# =============================================================================\n",
    "class PhaseShift(Bus):\n",
    "\n",
    "    LATENCY = 3      # datapath latency in samples (L = 3 since FIX 6; see above)\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40300000)\n",
    "        self.f_ref = None\n",
    "\n",
    "    def config_delay(self, f):\n",
    "        \"\"\"Programme the quarter-period delay line for frequency f.\"\"\"\n",
    "        best = None\n",
    "        for k in range(0, 9):\n",
    "            D = FS_CLK / (4.0 * f) + k * FS_CLK / f\n",
    "            if D < 1.0 or D > 1000.0:\n",
    "                continue\n",
    "            frac = D - np.floor(D)\n",
    "            score = min(frac, 1.0 - frac)       # interpolator error peaks at 0.5\n",
    "            if best is None or score < best[0]:\n",
    "                best = (score, int(np.floor(D)), frac)\n",
    "        if best is None:\n",
    "            raise ValueError('no usable quarter-period delay at %.3f MHz' % (f / 1e6))\n",
    "        self.w(0x08, best[1])                       # whole clocks\n",
    "        self.w(0x0C, int(round(best[2] * 16384)))   # fraction, Q0.14\n",
    "        self.w(0x10, 0)                             # bypass OFF\n",
    "        self.f_ref = f\n",
    "        return best[1], best[2]\n",
    "\n",
    "    def set(self, A, phi_deg):\n",
    "        \"\"\"Apply gain A and phase phi_deg (degrees).\"\"\"\n",
    "        if self.f_ref is None:\n",
    "            raise RuntimeError('call config_delay() first')\n",
    "        if not (0.0 <= A < 1.99):\n",
    "            # A x 16384 must stay inside int16. At A = 2.0 the coefficient is\n",
    "            # 32768, which wraps to -32768 and silently INVERTS the feedback.\n",
    "            raise ValueError('gain must be in [0, 1.99)')\n",
    "        phi = phi_deg - 360.0 * self.LATENCY * self.f_ref / FS_CLK\n",
    "        self.w(0x00, int(round(A * np.cos(np.radians(phi)) * 16384)) & 0xFFFF)\n",
    "        self.w(0x04, int(round(A * np.sin(np.radians(phi)) * 16384)) & 0xFFFF)\n",
    "\n",
    "    def off(self):\n",
    "        self.w(0x00, 0)\n",
    "        self.w(0x04, 0)\n",
    "\n",
    "\n",
    "ps = PhaseShift()\n",
    "ps.off()\n",
    "print('phase shifter mapped, feedback off')"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n#  DIGITAL RESONATOR (THE EMULATOR) - base 0x40400000\n# =============================================================================\n#  Used only in Step 1. Enabled, it REPLACES the digitised input, so the coil can\n#  stay connected and simply be ignored - a known answer is available at any\n#  moment without recabling.\n#  Coefficients c = r cos(w0) x 2**17, s = r sin(w0) x 2**17, w0 = 2 pi f0/125e6,\n#  r = 1 - pi (f0/125e6)/Q. Rounding moves the pole, so the QUANTISED values\n#  recovered below are the real known answer.\n# =============================================================================\n",
    "class Emulator(Bus):\n",
    "\n",
    "    def __init__(self):\n",
    "        Bus.__init__(self, 0x40400000)\n",
    "        self.f0_q = None\n",
    "        self.q_q = None\n",
    "\n",
    "    def config(self, f0, Q, delay=15, oshift=7):\n",
    "        w0 = 2.0 * np.pi * f0 / FS_CLK\n",
    "        r = 1.0 - np.pi * (f0 / FS_CLK) / Q\n",
    "        ci = int(round(r * np.cos(w0) * 131072))\n",
    "        cs = int(round(r * np.sin(w0) * 131072))\n",
    "        self.w(0x04, ci & 0x3FFFF)\n",
    "        self.w(0x08, cs & 0x3FFFF)\n",
    "        self.w(0x0C, delay)      # 15 clocks = the board's real 119.87 ns loop\n",
    "        self.w(0x10, oshift)\n",
    "        rq = np.hypot(ci, cs) / 131072.0\n",
    "        self.f0_q = np.arctan2(cs, ci) / (2.0 * np.pi) * FS_CLK\n",
    "        self.q_q = np.pi * (self.f0_q / FS_CLK) / (1.0 - rq)\n",
    "        return self.f0_q, self.q_q\n",
    "\n",
    "    def enable(self):\n",
    "        self.w(0x00, 1)\n",
    "\n",
    "    def disable(self):\n",
    "        self.w(0x00, 0)\n",
    "\n",
    "    def clear(self):\n",
    "        self.w(0x00, 3)          # zero the state and the sticky clip flag\n",
    "\n",
    "    def enabled(self):\n",
    "        return bool(self.r(0x00) & 1)\n",
    "\n",
    "    def clipped(self):\n",
    "        return bool(self.r(0x14) & 1)\n",
    "\n",
    "\n",
    "emu = Emulator()\n",
    "emu.disable()\n",
    "print('emulator mapped and DISABLED (the board is listening to its real input)')"
   ]
  },
