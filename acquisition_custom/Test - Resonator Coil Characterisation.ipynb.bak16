    "\n",
    "---\n",
    "# Imports, and the one rule that must not be broken\n",
    "\n",
    "**Every register access is a single 32-bit read or write.** A bulk `mmap` slice becomes a\n",
    "burst transfer that the bridge between the processor's general-purpose port and the internal\n",
    "register bus cannot acknowledge. It locks the bus and reboots the board — no traceback, no\n",
    "log, just a board that vanishes. The loops below look inefficient on purpose; do not\n",
    "\"optimise\" them.\n",
    "\n",
    "Ordinary DDR memory is different. Bulk reads *there* are fine and fast, which is why the\n",
    "capture routine reads its records in one slice while the register drivers never do.\n",
    "\n",
    "The two shims exist because this board carries older numpy and matplotlib than a current\n",
    "desktop: `nan_to_num`'s `nan=` keyword arrived in numpy 1.17 and `Axes.set_facecolor` in\n",
    "matplotlib 2.0."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "import os, mmap, struct, time, json\n",
    "import numpy as np\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "def s32(v):\n",
    "    \"\"\"Reinterpret a 32-bit register value as a signed integer.\"\"\"\n",
    "    return v - (1 << 32) if v & 0x80000000 else v\n",
    "\n",
    "\n",
    "class Bus(object):\n",
    "    \"\"\"One register block, accessed strictly one 32-bit word at a time.\"\"\"\n",
    "\n",
    "    def __init__(self, base, span=0x1000):\n",
    "        self.base = base\n",
    "        self.fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)\n",
    "        self.m = mmap.mmap(self.fd, span, offset=base)\n",
    "\n",
    "    def w(self, off, val):\n",
    "        self.m[off:off + 4] = struct.pack('<I', val & 0xFFFFFFFF)\n",
    "\n",
    "    def r(self, off):\n",
    "        return struct.unpack('<I', self.m[off:off + 4])[0]\n",
    "\n",
    "    def rs(self, off):\n",
    "        return s32(self.r(off))\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "#  PLOTTING COMPATIBILITY  -  this board runs matplotlib 1.x\n",
    "# =============================================================================\n",
    "#  The 'C0'..'C9' colour shorthand arrived in matplotlib 2.0. On 1.x it is not\n",
    "#  rejected when you pass it - it is accepted, stored, and then raises\n",
    "#\n",
    "#      ValueError: to_rgba: Invalid rgba arg \"C3\"\n",
    "#\n",
    "#  from inside the draw, at which point the figure is already built. What you see\n",
    "#  is a traceback followed by a bare <matplotlib.figure.Figure at 0x...> instead\n",
    "#  of a plot, and every OTHER cell still runs, so it looks like a plotting\n",
    "#  nuisance rather than a version problem. Every colour in this notebook is\n",
    "#  therefore written out in full.\n",
    "CLR_BLUE   = '#1f77b4'\n",
    "CLR_ORANGE = '#ff7f0e'\n",
    "CLR_GREEN  = '#2ca02c'\n",
    "CLR_RED    = '#d62728'\n",
    "CLR_GREY   = '0.5'\n",
    "\n",
    "# One place for the look of every figure. Setting it here means no cell needs to\n",
    "# repeat grid, font and layout calls.\n",
    "plt.rcParams.update({\n",
    "    'figure.dpi': 110, 'savefig.dpi': 110, 'figure.autolayout': True,\n",
    "    'font.size': 9, 'axes.titlesize': 10, 'axes.labelsize': 9,\n",
    "    'legend.fontsize': 8, 'legend.framealpha': 0.9,\n",
    "    'xtick.labelsize': 8, 'ytick.labelsize': 8,\n",
    "    'axes.grid': True, 'grid.color': '0.88', 'grid.linewidth': 0.6,\n",
    "    'axes.axisbelow': True, 'lines.linewidth': 1.2, 'lines.markersize': 4,\n",
    "})\n",
    "\n",
    "try:                       # inline figures when running under Jupyter...\n",
    "    get_ipython().run_line_magic('matplotlib', 'inline')\n",
    "except Exception:          # ...and a file-only backend when running as a script\n",
    "    matplotlib.use('Agg')\n",
    "\n",
    "print('numpy %s, matplotlib %s' % (np.__version__, matplotlib.__version__))\n",
    "if int(matplotlib.__version__.split('.')[0]) < 2:\n",
    "    print('  matplotlib 1.x detected - using explicit hex colours (see above)')"
   ]
