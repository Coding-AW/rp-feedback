    "\n",
    "---\n",
    "# Step 6 — Is the measurement linear?\n",
    "\n",
    "The definitive test for \"am I loading the coil?\" is to weaken the coupling and see whether the\n",
    "quality factor stops changing. With the capacitors soldered on, that test is not available —\n",
    "so this is the one that is.\n",
    "\n",
    "Drive at three levels, each 6 dB apart, and fit each. A **linear** system returns the same\n",
    "centre and the same width at all three; only the height changes. If either moves with drive\n",
    "level, something is compressing — the input stage, the coil itself, or an amplifier if one is\n",
    "fitted — and every number in this notebook taken at the higher level is suspect.\n",
    "\n",
    "This is also the cheapest way to discover you have been running with `DRIVE_FRAC` too high."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "\n",
    "# =============================================================================\n",
    "#  STEP 6 - LINEARITY\n",
    "# =============================================================================\n",
    "print('=' * 68)\n",
    "print('STEP 6 - linearity against drive level')\n",
    "print('=' * 68)\n",
    "\n",
    "acq.start(DEC_USE)\n",
    "grid6 = F0 + np.linspace(-3.0, 3.0, 41) * LW   # wings carry the leak phase\n",
    "\n",
    "lin_rows = []\n",
    "lin_floor, lin_reg = [], []\n",
    "for _fr in DRIVE_LIN_FRACS:\n",
    "    frac = _fr * DRIVE_FRAC\n",
    "    f6, z6 = sweep(grid6, drive_frac=frac, navg=N_AVG, level_guard=0.95)\n",
    "    gen.amp(0.0)\n",
    "    # Fano fit: the leak is present at every drive level, and a symmetric\n",
    "    # fit reads its interference as a change in the coil.\n",
    "    fit6 = fit_lorentzian(f6, np.abs(z6) ** 2)\n",
    "    lin_rows.append((frac, fit6))\n",
    "    _reg = int(round(frac * 8192))\n",
    "    _floor = fit6['base'] / max(fit6['peak'], 1e-300)\n",
    "    lin_floor.append(_floor); lin_reg.append(_reg)\n",
    "    print('  drive %7.5f (%+5.1f dB, set_amp %4d) : f0 = %.6f MHz, '\n",
    "          'lw = %6.2f kHz, Q = %6.1f, floor/peak = %.2f'\n",
    "          % (frac, 20 * np.log10(_fr / DRIVE_LIN_FRACS[0]), _reg,\n",
    "             fit6['f0'] / 1e6, fit6['lw'] / 1e3, fit6['Q'], _floor))\n",
    "\n",
    "_f0s = np.array([r[1]['f0'] for r in lin_rows])\n",
    "_qs = np.array([r[1]['Q'] for r in lin_rows])\n",
    "_pk = np.array([r[1]['peak'] for r in lin_rows])\n",
    "_fr = np.array([r[0] for r in lin_rows])\n",
    "\n",
    "# NOT d_f0: Step 7 uses that name for its array of fitted centres.\n",
    "d_f0_spread = (_f0s.max() - _f0s.min()) / LW\n",
    "d_q = (_qs.max() - _qs.min()) / _qs.mean()\n",
    "# a linear system's peak power scales as the square of the drive\n",
    "scale_err = _pk / (_pk[0] * (_fr / _fr[0]) ** 2) - 1.0\n",
    "\n",
    "print('')\n",
    "print('  centre spread across the ladder : %.3f linewidths' % d_f0_spread)\n",
    "print('  Q spread across the ladder      : %.1f%%' % (100 * d_q))\n",
    "print('  peak power vs drive-squared     : %s'\n",
    "      % ', '.join('%+.1f%%' % (100 * e) for e in scale_err))\n",
    "print('-' * 68)\n",
    "_shape_ok = (d_f0_spread < 0.10) and (d_q < 0.05)\n",
    "_scale_ok = np.max(np.abs(scale_err)) < 0.15\n",
    "LINEAR_OK = _shape_ok and _scale_ok\n",
    "\n",
    "# Is the test even answerable at this signal level? Two ways it is not: the\n",
    "# fitted floor swamping the peak, and the DAC running out of counts.\n",
    "_floor_bad = max(lin_floor) > 0.30 if lin_floor else False\n",
    "_reg_bad = min(lin_reg) < 100 if lin_reg else False\n",
    "print('  smallest set_amp used  : %d counts%s'\n",
    "      % (min(lin_reg) if lin_reg else 0,\n",
    "         '   <- too coarse for a scaling test' if _reg_bad else ''))\n",
    "print('  worst floor / peak     : %.2f%s'\n",
    "      % (max(lin_floor) if lin_floor else 0.0,\n",
    "         '   <- the fit is measuring floor, not signal' if _floor_bad else ''))\n",
    "print('-' * 68)\n",
    "if LINEAR_OK:\n",
    "    print('PASS - centre, width and scaling are all drive-independent')\n",
    "elif _shape_ok and (_floor_bad or _reg_bad):\n",
    "    LINEAR_OK = True\n",
    "    print('INCONCLUSIVE ON SCALING, BUT SHAPE IS CLEAN.')\n",
    "    print('  Centre and width are drive-independent (%.3f linewidths, %.1f%%),'\n",
    "          % (d_f0_spread, 100 * d_q))\n",
    "    print('  which is what non-linearity would move first. Only the power-versus-')\n",
    "    print('  drive-squared column fails, and it cannot be trusted here:')\n",
    "    if _floor_bad:\n",
    "        print('    - the fitted floor is %.0f%% of the peak, so \"peak\" is mostly floor'\n",
    "              % (100 * max(lin_floor)))\n",
    "    if _reg_bad:\n",
    "        print('    - the DAC amplitude register runs down to %d counts, where its'\n",
    "              % min(lin_reg))\n",
    "        print('      own quantisation costs several percent of the fundamental')\n",
    "    print('  LOWERING THE DRIVE MAKES THIS WORSE, NOT BETTER. To answer it')\n",
    "    print('  properly, put a pad in front of the amplifier and set EXT_PAD_DB:')\n",
    "    print('  the delivered power is unchanged but the converter gets ~%dx more'\n",
    "          % 10)\n",
    "    print('  counts to work with.')\n",
    "else:\n",
    "    print('CHECK - the centre or width moves with drive level. That is real')\n",
    "    print('        non-linearity. Lower DRIVE_FRAC and repeat Steps 3 and 5.')"
   ]
