# =============================================================================
#  Add the acquisition-system sources to the Vivado project
# =============================================================================
#
#  WHAT THIS DOES
#  Vivado does not pick up new files just because they exist in the source
#  folder - every file has to be listed in the project explicitly. This script
#  adds the four new acquisition modules and refreshes the compile order.
#
#  HOW TO RUN IT
#  Open Test_Project.xpr in Vivado 2020.1, then in the Tcl console at the
#  bottom of the window type:
#
#      source C:/rp/prj/v0.94/Test_Project/acquisition_custom/add_acquisition_sources.tcl
#
#  Note the FORWARD slashes - Tcl uses them even on Windows.
#
#  It is safe to run more than once. Files already in the project are skipped
#  rather than duplicated.
#
#  WHAT IT DOES NOT DO
#  It does not modify red_pitaya_top.sv or red_pitaya_scope.v. Those are edited
#  in place and are already part of the project, so Vivado picks the changes up
#  automatically.
# =============================================================================

set proj_root [file dirname [file dirname [file normalize [info script]]]]
set rtl_dir   "$proj_root/Test_Project.srcs/sources_1/imports/rp/rtl/classic"

set acq_files [list \
  "$rtl_dir/red_pitaya_acq_dds.v"   \
  "$rtl_dir/red_pitaya_acq_mixer.v" \
  "$rtl_dir/red_pitaya_acq_cic.v"   \
  "$rtl_dir/red_pitaya_acq_fir.v"   \
  "$rtl_dir/red_pitaya_acq_dma.v"   \
  "$rtl_dir/red_pitaya_acq.v"       \
  "$rtl_dir/red_pitaya_resonator.v" \
]

# The filter coefficients live in a Verilog include file, GENERATED by
# acquisition_custom/gen_fir_coeffs.py. It must be added to the project with the
# "Verilog Header" type, otherwise Vivado treats it as an ordinary source and
# tries to compile it on its own - which fails, because it is a bare list of
# assignments with no module around it.
#
# build_id.vh is the same kind of thing: a generated include, written by
# build_project.tcl, holding a hash of the Verilog this bitstream was built
# from. It is what register 0x48 reports.
set acq_headers [list \
  "$rtl_dir/fir_coeffs.vh"  \
  "$rtl_dir/fir_params.vh" \
  "$rtl_dir/build_id.vh" \
]

puts "-------------------------------------------------------------"
puts " Adding acquisition-system sources"
puts " Project root: $proj_root"
puts "-------------------------------------------------------------"

# Files already known to the project, so we can skip duplicates.
set existing [get_files -quiet]

foreach f $acq_files {
    if {![file exists $f]} {
        puts " MISSING   : $f"
        puts "             ^ file not found - check the path and try again"
        continue
    }
    set already 0
    foreach e $existing {
        if {[string equal [file normalize $e] [file normalize $f]]} { set already 1 }
    }
    if {$already} {
        puts " skipped   : [file tail $f]  (already in the project)"
    } else {
        add_files -norecurse -fileset sources_1 $f
        puts " added     : [file tail $f]"
    }
}

foreach f $acq_headers {
    if {![file exists $f]} {
        puts " MISSING   : $f"
        puts "             ^ run acquisition_custom/gen_fir_coeffs.py to create it"
        continue
    }
    set already 0
    foreach e $existing {
        if {[string equal [file normalize $e] [file normalize $f]]} { set already 1 }
    }
    if {!$already} { add_files -norecurse -fileset sources_1 $f }
    # This is the important part: mark it a header so Vivado includes it rather
    # than trying to compile it as a module of its own.
    set_property file_type "Verilog Header" [get_files [file tail $f]]
    puts " header    : [file tail $f]  (marked as Verilog Header)"
}

# -----------------------------------------------------------------------------
#  Implementation-only constraints
#
#  red_pitaya_impl.xdc holds the two constraints that refer to clocks which do
#  not exist until the Zynq processing system has been elaborated - which does
#  not happen during synthesis. Reading them then produces
#      [Vivado 12-4739] set_clock_groups: No valid object(s) found
#  and guarding them with a Tcl "if" is not allowed either, because an XDC file
#  has no control flow:
#      [Designutils 20-1307] Command 'if' is not supported in the xdc file
#
#  Marking the file "not used in synthesis" is the clean answer.
# -----------------------------------------------------------------------------
set impl_xdc "$proj_root/Test_Project.srcs/constrs_1/imports/rp/sdc/red_pitaya_impl.xdc"

if {[file exists $impl_xdc]} {
    set already 0
    foreach e [get_files -quiet] {
        if {[string equal [file normalize $e] [file normalize $impl_xdc]]} { set already 1 }
    }
    if {!$already} { add_files -fileset constrs_1 -norecurse $impl_xdc }
    set_property used_in_synthesis      false [get_files red_pitaya_impl.xdc]
    set_property used_in_implementation true  [get_files red_pitaya_impl.xdc]
    puts " constraints: red_pitaya_impl.xdc  (implementation only)"
} else {
    puts " MISSING   : $impl_xdc"
}

# Make sure Vivado works out which module instantiates which, and confirm the
# top-level module has not been changed by accident.
update_compile_order -fileset sources_1
set_property top red_pitaya_top [current_fileset]

puts "-------------------------------------------------------------"
puts " Top module : [get_property top [current_fileset]]"
puts " Done. Next: Flow Navigator -> Generate Bitstream"
puts ""
puts " Expected after the build:"
puts "   - 0 failing setup endpoints (as in stage 1)"
puts "   - DSP usage rises from 6 to about 10 (the mixer adds 2 per channel)"
puts "   - Block RAM rises by 1 (the local oscillator's sine table)"
puts "-------------------------------------------------------------"
