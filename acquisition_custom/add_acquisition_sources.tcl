# =============================================================================
#  Add the acquisition-system sources to the Vivado project
# =============================================================================
#
#  WHAT THIS DOES
#  Vivado does not pick up new files just because they exist in the source
#  folder - every file has to be listed in the project explicitly. This script
#  adds the custom modules and refreshes the compile order.
#
#  It also CHECKS, at the end, that every module red_pitaya_top.sv instantiates
#  can actually be found in the project, and stops the build if one cannot. See
#  the note above that check for the two builds this would have saved.
#
#  HOW TO RUN IT
#  Open Test_Project.xpr in Vivado 2020.1, then in the Tcl console at the
#  bottom of the window type:
#
#      source C:/rp/prj/v0.94/Test_Project/acquisition_custom/add_acquisition_sources.tcl
#
#  Note the FORWARD slashes - Tcl uses them even on Windows.
#
#  It is safe to run more than once. Files already in the project are skipped
#  rather than duplicated.
#
#  WHAT IT DOES NOT DO
#  It does not modify red_pitaya_top.sv or red_pitaya_scope.v. Those are edited
#  in place and are already part of the project, so Vivado picks the changes up
#  automatically.
# =============================================================================

set proj_root [file dirname [file dirname [file normalize [info script]]]]
set rtl_dir   "$proj_root/Test_Project.srcs/sources_1/imports/rp/rtl/classic"

#  Every custom module that is NOT part of the stock Red Pitaya project and so
#  has to be introduced to Vivado explicitly. Adding a file to rtl/classic/ and
#  instantiating it in red_pitaya_top.sv is not enough - if its name is not in
#  this list, synthesis reports "module not found" and nothing else explains why.
set acq_files [list \
  "$rtl_dir/red_pitaya_acq_dds.v"   \
  "$rtl_dir/red_pitaya_acq_mixer.v" \
  "$rtl_dir/red_pitaya_acq_cic.v"   \
  "$rtl_dir/red_pitaya_acq_fir.v"   \
  "$rtl_dir/red_pitaya_acq_dma.v"   \
  "$rtl_dir/red_pitaya_acq.v"       \
  "$rtl_dir/red_pitaya_resonator.v" \
  "$rtl_dir/red_pitaya_sequencer.v" \
]

# The filter coefficients live in a Verilog include file, GENERATED by
# acquisition_custom/gen_fir_coeffs.py. It must be added to the project with the
# "Verilog Header" type, otherwise Vivado treats it as an ordinary source and
# tries to compile it on its own - which fails, because it is a bare list of
# assignments with no module around it.
#
# build_id.vh is the same kind of thing: a generated include, written by
# build_project.tcl, holding a hash of the Verilog this bitstream was built
# from. It is what register 0x48 reports.
set acq_headers [list \
  "$rtl_dir/fir_coeffs.vh"  \
  "$rtl_dir/fir_params.vh" \
  "$rtl_dir/build_id.vh" \
]

puts "-------------------------------------------------------------"
puts " Adding acquisition-system sources"
puts " Project root: $proj_root"
puts "-------------------------------------------------------------"

# Files already known to the project, so we can skip duplicates.
set existing [get_files -quiet]

foreach f $acq_files {
    if {![file exists $f]} {
        puts " MISSING   : $f"
        puts "             ^ file not found - check the path and try again"
        continue
    }
    set already 0
    foreach e $existing {
        if {[string equal [file normalize $e] [file normalize $f]]} { set already 1 }
    }
    if {$already} {
        puts " skipped   : [file tail $f]  (already in the project)"
    } else {
        add_files -norecurse -fileset sources_1 $f
        puts " added     : [file tail $f]"
    }
}

foreach f $acq_headers {
    if {![file exists $f]} {
        puts " MISSING   : $f"
        puts "             ^ run acquisition_custom/gen_fir_coeffs.py to create it"
        continue
    }
    set already 0
    foreach e $existing {
        if {[string equal [file normalize $e] [file normalize $f]]} { set already 1 }
    }
    if {!$already} { add_files -norecurse -fileset sources_1 $f }
    # This is the important part: mark it a header so Vivado includes it rather
    # than trying to compile it as a module of its own.
    set_property file_type "Verilog Header" [get_files [file tail $f]]
    puts " header    : [file tail $f]  (marked as Verilog Header)"
}

# -----------------------------------------------------------------------------
#  Implementation-only constraints
#
#  red_pitaya_impl.xdc holds the two constraints that refer to clocks which do
#  not exist until the Zynq processing system has been elaborated - which does
#  not happen during synthesis. Reading them then produces
#      [Vivado 12-4739] set_clock_groups: No valid object(s) found
#  and guarding them with a Tcl "if" is not allowed either, because an XDC file
#  has no control flow:
#      [Designutils 20-1307] Command 'if' is not supported in the xdc file
#
#  Marking the file "not used in synthesis" is the clean answer.
# -----------------------------------------------------------------------------
set impl_xdc "$proj_root/Test_Project.srcs/constrs_1/imports/rp/sdc/red_pitaya_impl.xdc"

if {[file exists $impl_xdc]} {
    set already 0
    foreach e [get_files -quiet] {
        if {[string equal [file normalize $e] [file normalize $impl_xdc]]} { set already 1 }
    }
    if {!$already} { add_files -fileset constrs_1 -norecurse $impl_xdc }
    set_property used_in_synthesis      false [get_files red_pitaya_impl.xdc]
    set_property used_in_implementation true  [get_files red_pitaya_impl.xdc]
    puts " constraints: red_pitaya_impl.xdc  (implementation only)"
} else {
    puts " MISSING   : $impl_xdc"
}

# Make sure Vivado works out which module instantiates which, and confirm the
# top-level module has not been changed by accident.
update_compile_order -fileset sources_1
set_property top red_pitaya_top [current_fileset]

# -----------------------------------------------------------------------------
#  CHECK: can every module the top level instantiates actually be found?
#
#  WHY THIS EXISTS
#  On 2026-08-03 the parameter sequencer was written, committed, instantiated in
#  red_pitaya_top.sv and added to the build fingerprint - but never added to the
#  list above, so it was never in the Vivado project. Synthesis reported ten
#  errors. Nine were consequences of the first:
#
#      [Synth 8-439]  module 'red_pitaya_sequencer' not found
#      [Synth 8-6038] cannot resolve hierarchical name for the item 'addr'  x7
#      [Synth 8-6156] failed synthesizing module 'red_pitaya_top'
#
#  The seven middle errors are the seven sys[7].* connections on an instance
#  whose port list Vivado never saw. They point at the bus, which is working
#  perfectly, and that is what makes this failure expensive to read.
#
#  Nothing already in the project could have caught it. The build fingerprint
#  hashes files on disk, so it changed and made the module look present.
#  tools/verify_rtl.py reads the source tree, not the project, so it passed.
#  Both answer "does the file exist", and the question that mattered was "does
#  Vivado know about it".
#
#  This check asks the second question, before the 15-minute build rather than
#  after it.
#
#  HOW IT WORKS
#  Scan red_pitaya_top.sv for instantiations, skip Xilinx primitives and
#  language keywords, then confirm each remaining name is actually DECLARED in
#  one of the files the project contains - by reading the files and looking for
#  its "module" or "interface" line, not by assuming the file is named after the
#  module. Several files here hold more than one module, and sys_bus_stub.sv and
#  sys_bus_interconnect.sv sit outside rtl/classic entirely, so a filename match
#  would be guesswork.
#
#  It errors out rather than warning - a warning in a 400-line log is a warning
#  nobody reads.
# -----------------------------------------------------------------------------
set top_sv "$proj_root/Test_Project.srcs/sources_1/imports/rp/prj/v0.94/rtl/red_pitaya_top.sv"

# Names that look like instantiations but are not modules of ours: Xilinx
# primitives, SystemVerilog keywords, and constructs that match the same shape.
set not_modules [list \
  IOBUF OBUF IBUF IBUFDS OBUFDS BUFG BUFGP BUFIO BUFR ODDR IDDR OSERDESE2 \
  ISERDESE2 MMCME2_BASE PLLE2_BASE DSP48E1 RAMB18E1 RAMB36E1 FDRE FDSE LUT6 \
  if else for while case begin end module endmodule always assign initial \
  input output inout wire reg logic parameter localparam generate endgenerate \
  function endfunction task endtask return typedef struct enum union import \
  package endpackage interface endinterface modport property assert posedge \
  negedge signed unsigned bit byte int integer real time string const var \
]

if {![file exists $top_sv]} {
    puts " WARNING   : cannot find red_pitaya_top.sv - instantiation check skipped"
} else {
    set fh [open $top_sv r]
    set src [read $fh]
    close $fh

    # Strip block comments, then line comments. Order matters.
    regsub -all {/\*.*?\*/} $src " " src
    regsub -all {//[^\n]*}  $src " " src

    # An instantiation takes one of three shapes. The separator between the two
    # names must be REAL whitespace (\s+), not optional: with \s* the pattern
    # happily splits "if (" into a module "i" and an instance "f", and then
    # reports a missing module called i. That cost a re-run to spot.
    set id {[A-Za-z_][A-Za-z0-9_]*}
    set re_param  "^\\s*($id)\\s*#\\s*\\(.*\\)\\s*($id)\\s*(?:\\\[\[^\\\]\]*\\\]\\s*)?\\("
    set re_plain  "^\\s*($id)\\s+($id)\\s*(?:\\\[\[^\\\]\]*\\\]\\s*)?\\("
    set re_open   "^\\s*($id)\\s*#\\s*\\(\\s*\$"

    set found [list]
    foreach line [split $src \n] {
        set mod ""
        if {[regexp $re_param $line -> m i]} {
            set mod $m
        } elseif {[regexp $re_plain $line -> m i]} {
            set mod $m
        } elseif {[regexp $re_open $line -> m]} {
            # module_name #(  with the parameters on the lines below
            set mod $m
        }
        if {$mod eq ""} continue
        if {[lsearch -exact $not_modules $mod] >= 0} continue
        if {[lsearch -exact $found $mod] < 0} { lappend found $mod }
    }

    # Every module and interface DECLARED in the files the project contains.
    set declared [list]
    foreach f [get_files -quiet -of_objects [get_filesets sources_1]] {
        if {![file exists $f]} continue
        if {[catch {open $f r} dh]} continue
        set body [read $dh]
        close $dh
        regsub -all {/\*.*?\*/} $body " " body
        regsub -all {//[^\n]*}  $body " " body
        foreach m [regexp -all -inline "(?:^|\\n)\\s*(?:module|interface)\\s+($id)" $body] {
            if {[regexp "^$id\$" $m] && [lsearch -exact $declared $m] < 0} {
                lappend declared $m
            }
        }
    }

    set missing [list]
    foreach mod $found {
        if {[lsearch -exact $declared $mod] < 0} { lappend missing $mod }
    }

    if {[llength $missing] == 0} {
        puts " check     : all [llength $found] instantiated module(s) found in the project"
    } else {
        puts ""
        puts " *** STOPPING - [llength $missing] module(s) instantiated but NOT in the project ***"
        puts ""
        foreach m $missing {
            puts "     $m"
            if {[file exists "$rtl_dir/$m.v"]} {
                puts "       the file rtl/classic/$m.v EXISTS but is not in the project."
                puts "       Add \"\$rtl_dir/$m.v\" to acq_files at the top of this script."
            } elseif {[file exists "$rtl_dir/$m.sv"]} {
                puts "       the file rtl/classic/$m.sv EXISTS but is not in the project."
                puts "       Add \"\$rtl_dir/$m.sv\" to acq_files at the top of this script."
            } else {
                puts "       no matching file in rtl/classic/ either - has it been written yet?"
            }
        }
        puts ""
        puts " Synthesis would fail with \[Synth 8-439\] module not found, followed by"
        puts " one \[Synth 8-6038\] per bus connection on the missing instance. Fixing"
        puts " the list above fixes all of them at once."
        puts ""
        error "add_acquisition_sources.tcl: [llength $missing] module(s) missing from the project"
    }
}

puts "-------------------------------------------------------------"
puts " Top module : [get_property top [current_fileset]]"
puts " Done. Next: Flow Navigator -> Generate Bitstream"
puts ""
puts " Expected after the build:"
puts "   - 0 failing setup endpoints (as in stage 1)"
puts "   - DSP usage rises from 6 to about 10 (the mixer adds 2 per channel)"
puts "   - Block RAM rises by 1 (the local oscillator's sine table)"
puts "-------------------------------------------------------------"
