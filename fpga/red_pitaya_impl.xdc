############################################################################
#  Constraints that can ONLY be evaluated at IMPLEMENTATION
#
#  This file must be marked "not used in synthesis". The Tcl script
#  tools/vivado_build.tcl sets that automatically:
#
#      set_property used_in_synthesis     false [get_files red_pitaya_impl.xdc]
#      set_property used_in_implementation true  [get_files red_pitaya_impl.xdc]
#
#  WHY A SEPARATE FILE
#  Both constraints below refer to clocks that do not exist during synthesis:
#  the Zynq processing system is still an unresolved black box then, so its
#  FCLK outputs have not been created. Reading them at that point produced
#
#      [Vivado 12-4739] set_clock_groups: No valid object(s) found
#
#  The obvious fix - wrapping them in a Tcl "if" that checks whether the clocks
#  exist - does not work either, because an XDC file is a RESTRICTED SUBSET of
#  Tcl with no control flow:
#
#      [Designutils 20-1307] Command 'if' is not supported in the xdc constraint file
#
#  and the guarded constraint is then discarded entirely - the same silent
#  failure the guard was meant to prevent.
#
#  Splitting them into a file synthesis never reads solves both cleanly, with no
#  conditionals and no warnings. Anything reported against these lines in future
#  is a real problem.
############################################################################


############################################################################
# 1. The processor's clocks are unrelated to the oscillator's
#
# clk_fpga_* are generated by a PLL inside the Zynq processing system. adc_clk
# and everything derived from it come from the external 125 MHz oscillator.
# They have no fixed phase relationship, so no path between the two families
# should be timed - anything crossing between them is synchronised in logic.
#
# -include_generated_clocks picks up every clock the PLL derives from adc_clk
# automatically, so this does not rot if a clock is renamed or added.
#
# NOTE ON SYNTAX: get_clocks takes ONE positional pattern, not a list of names.
# Writing "get_clocks clk_fpga_0 clk_fpga_1 ..." gives
#     [Common 17-165] Too many positional options
# and the WHOLE command is discarded. Use a glob pattern.
############################################################################
set_clock_groups -asynchronous \
  -group [get_clocks -include_generated_clocks adc_clk] \
  -group [get_clocks clk_fpga_*]


############################################################################
# 2. ADC data capture: declare the one-edge relationship
#
# THE SYMPTOM
# 28 hold-time violations at -2.162 ns, on exactly 28 endpoints - 14 data bits
# x 2 channels, i.e. every ADC data pin. Present in EVERY build of this project
# including the original, always at the same -2.162 ns, so not caused by any of
# the custom work.
#
# WHAT THE PATH REPORT SHOWS
#   data arrives : 3.400 (input delay) + 0.805 (input buffer) = 4.205 ns
#   capture edge : 6.011 ns after the same edge at the pin
#   required     : 6.011 + 0.191 (hold) + 0.166 (uncertainty) = 6.367 ns
#   slack        : 4.205 - 6.367 = -2.162 ns
#
# The whole violation is 6.011 ns of CLOCK INSERTION DELAY:
#   input buffer 0.983 + routing 1.306 + PLL 0.089 + routing 1.754
#   + global clock buffer 0.101 + routing 1.777
#
# It is uncompensated because red_pitaya_pll uses INTERNAL feedback (CLKFBOUT
# tied straight to CLKFBIN), which aligns the PLL's output to its input at the
# PLL's own pins and does nothing about the buffers either side of it.
#
# WHY THE HARDWARE IS FINE
# Data settles 4.205 ns after a clock edge at the pin and holds until the next
# change 8 ns later. The capture edge falls at 6.011 ns - inside that window,
# 1.8 ns after the data settles and 6.2 ns before it changes again.
#
# What Vivado objects to is the LABELLING: because the capture clock is delayed
# by more than half a period, each register captures the data launched by the
# SAME numbered pin edge, not the previous one. The default analysis assumes the
# previous one, so it reports the new data as arriving "too early".
#
# THE FIX
# A hold multicycle of 1 moves the hold check one period earlier, which is
# exactly the statement "the data captured at edge N was launched at edge N".
# Slack becomes +5.8 ns.
#
# This is a DECLARATION, not a suppression: setup is still checked on all 28
# endpoints and still passes.
#
# Vivado also notes
#     [Designutils 20-1567] Use of 'set_multicycle_path' with '-hold' is not
#     supported by synthesis. The constraint will not be passed to synthesis.
# which is correct and harmless - hold analysis only happens at implementation,
# which is the one place this file is read.
############################################################################
set_multicycle_path -hold -end 1 -from [get_clocks adc_clk] -to [get_clocks pll_adc_clk]
